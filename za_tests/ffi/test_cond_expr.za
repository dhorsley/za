#!/usr/bin/env za

# Test conditional expression parsing without full OpenSSL header
# This reproduces the issue with OPENSSL_API_LEVEL comparisons
# Also covers ternary operators in #define/#if (previously #if ternaries
# were forced to false by the AUTO header parser).

module "libc.so.6" as test auto "./test_cond.h"
use +test

println "Conditional expressions parsed successfully!"

fails = 0

define expect_eq(actual, want, name)
    if actual == want
        println format("PASS %s: %v", name, actual)
    else
        println format("FAIL %s: got %v, want %v", name, actual, want)
        @fails = fails + 1
    endif
end

# direct ternary in #if condition
expect_eq(TEST_DIRECT_TERNARY, 1, "direct ternary #if true branch")

# false ternary condition must take the #else branch
expect_eq(TEST_FALSE_TERNARY, 0, "false ternary #if takes else")

# ternary defined via #define, referenced in #if
expect_eq(TEST_INDIRECT_TERNARY, 1, "ternary via #define evaluates to 1")

if fails > 0
    println format("FAIL: %d ternary test(s) failed", fails)
    exit 1
endif

println "Test passed - no 'true' substitution errors!"
