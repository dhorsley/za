# Test else-if control flow construct

global side_effect_count int = 0

define bump_side_effect()
    @side_effect_count = side_effect_count + 1
    return true
end

# Test 1: Simple else-if chain
define test_simple_else_if()
    x = 5
    if x < 3
        return "first"
    else if x < 7
        return "second"
    else
        return "third"
    endif
end

# Test 2: else-if with no trailing else
define test_else_if_no_else()
    x = 10
    if x < 5
        return "low"
    else if x < 15
        return "mid"
    endif
    return "fallthrough"
end

# Test 3: Multiple else-if clauses
define test_multiple_else_if()
    x = 20
    if x < 10
        return "a"
    else if x < 15
        return "b"
    else if x < 25
        return "c"
    else
        return "d"
    endif
end

# Test 4: Nested if inside else-if
define test_nested_else_if()
    x = 3
    y = 7
    if x < 5
        if y < 5
            return "inner-low"
        else if y < 10
            return "inner-mid"
        else
            return "inner-high"
        endif
    else
        return "outer"
    endif
end

# Test 5: else-if false falls through to else
define test_else_if_false()
    x = 100
    if x < 50
        return "small"
    else if x < 80
        return "medium"
    else
        return "large"
    endif
end

# Test 6: else-if with expression evaluation
define test_else_if_expr()
    a = 3
    b = 4
    if a + b < 5
        return "low"
    else if a + b == 7
        return "correct"
    else
        return "high"
    endif
end

# Test 7: true if followed by else-if (ASSIGNMENT, not return) — bug reproduction
# Prior to the fix, the else-if would execute even though the first if was true,
# overwriting 'result' with 2 instead of keeping it at 1.
define test_else_if_after_true_if()
    x = 21.0
    result = 0
    if x >= 20.0
        result = 1
    else if x >= 18.0
        result = 2
    else if x >= 5.0 && x < 7.0
        result = 3
    else
        result = 4
    endif
    return result
end

# Test 8: true if with || followed by else-if
define test_else_if_with_or()
    h = 21.0
    opacity = 0.0
    if h >= 20.0 || h < 5.0
        opacity = 1.0
    else if h >= 18.0 && h < 20.0
        opacity = 0.5
    else if h >= 5.0 && h < 7.0
        opacity = 0.25
    endif
    return opacity
end

# Test 9: plain else should not execute after true if
define test_else_skipped_after_true_if()
    y = 10
    result = 0
    if y < 20
        result = 1
    else
        result = 2
    endif
    return result
end

# Test 10: else-if chain where second condition is true but first already matched
define test_else_if_second_true_but_first_matched()
    z = 5
    result = 0
    if z < 10
        result = 1
    else if z < 20
        result = 2
    else
        result = 3
    endif
    return result
end

# Test 11: inline semicolon syntax
define test_else_if_inline()
    x = 3
    if x == 1; result = 1; else if x == 3; result = 3; else; result = 9; endif
    return result
end

# Test 12: else-if condition with side effects must not evaluate after a match
define test_else_if_short_circuit()
    x = 10
    result = 0
    if x > 5
        result = 1
    else if bump_side_effect()
        result = 2
    endif
    return result
end

# Test 13: all conditions false with no trailing else
define test_else_if_all_false_no_else()
    x = 100
    result = 0
    if x < 10
        result = 1
    else if x < 50
        result = 2
    endif
    return result
end

# Test 14: else-if inside a loop resets match state each iteration
define test_else_if_in_loop()
    out = ""
    for i = 0 to 4
        if i == 1
            out = out + "a"
        else if i == 3
            out = out + "b"
        else
            out = out + "c"
        endif
    endfor
    return out
end

# Test 15: nested if/else-if inside an else-if body
define test_else_if_nested_inner()
    x = 50
    y = 5
    if x < 10
        return "outer"
    else if x < 100
        if y < 3
            return "inner-a"
        else if y < 10
            return "inner-b"
        else
            return "inner-c"
        endif
    else
        return "fallback"
    endif
end

# Test 16: consecutive empty else-if clauses
define test_else_if_empty_clauses()
    x = 2
    result = 0
    if x == 1
        result = 1
    else if x == 2
    else if x == 3
        result = 3
    else
        result = 4
    endif
    return result
end

# Test 17: deep nesting (3 levels) with else-if at each level
define test_else_if_deep()
    a = 1
    b = 2
    c = 3
    result = ""
    if a == 1
        if b == 2
            if c == 3
                result = result + "x"
            else if c == 4
                result = result + "y"
            else
                result = result + "z"
            endif
        else if b == 3
            result = result + "w"
        endif
        result = result + "m"
    else if a == 2
        result = result + "n"
    endif
    return result
end

# Test 18: else-if inside a while loop
define test_else_if_in_while()
    i = 0
    out = ""
    while i < 5
        if i == 1
            out = out + "a"
        else if i == 3
            out = out + "b"
        else
            out = out + "c"
        endif
        i = i + 1
    endwhile
    return out
end

# Test 19: else-if inside a foreach loop
define test_else_if_in_foreach()
    out = ""
    foreach n in [1,2,3,4]
        if n == 1
            out = out + "a"
        else if n == 3
            out = out + "b"
        else
            out = out + "c"
        endif
    endfor
    return out
end

# Test 20: break and continue inside else-if branches
define test_else_if_break_continue()
    out = ""
    for i = 0 to 10
        if i == 2
            continue
        else if i == 4
            break
        else
            out = out + i
        endif
    endfor
    return out
end

# Test 21: return if modifier inside else-if branches
define test_else_if_return_if()
    x = 10
    if x > 20
        return if true, "a"
    else if x > 5
        return if true, "b"
    endif
    return "fallback"
end

# Test 22: return if with false condition inside else-if falls through
define test_else_if_return_if_false()
    x = 10
    if x > 20
        return if true, "a"
    else if x > 5
        return if false, "b"
    endif
    return "fallback"
end

# Test 23: non-boolean conditions are always false (strict truthiness)
define test_else_if_strict_truthiness()
    n = 5
    s = "x"
    result = 0
    if false
        result = 1
    else if n
        result = 2
    else if s
        result = 3
    else
        result = 4
    endif
    return result
end

# Test 24: sibling if/else-if chains at the same depth are independent
define test_else_if_sibling_chains()
    a = 1
    result = ""
    if a == 1
        if false
            result = result + "i"
        else if true
            result = result + "j"
        endif
        if true
            result = result + "k"
        else if true
            result = result + "l"
        endif
    else if true
        result = result + "o"
    endif
    return result
end

# Run tests
println "=== else-if tests ==="

result = test_simple_else_if()
println format("test_simple_else_if: %s (expected: second)", result)
assert result == "second"

result = test_else_if_no_else()
println format("test_else_if_no_else: %s (expected: mid)", result)
assert result == "mid"

result = test_multiple_else_if()
println format("test_multiple_else_if: %s (expected: c)", result)
assert result == "c"

result = test_nested_else_if()
println format("test_nested_else_if: %s (expected: inner-mid)", result)
assert result == "inner-mid"

result = test_else_if_false()
println format("test_else_if_false: %s (expected: large)", result)
assert result == "large"

result = test_else_if_expr()
println format("test_else_if_expr: %s (expected: correct)", result)
assert result == "correct"

result = test_else_if_after_true_if()
println format("test_else_if_after_true_if: %d (expected: 1)", result)
assert result == 1

result = test_else_if_with_or()
println format("test_else_if_with_or: %v (expected: 1.0)", result)
assert result == 1.0

result = test_else_skipped_after_true_if()
println format("test_else_skipped_after_true_if: %d (expected: 1)", result)
assert result == 1

result = test_else_if_second_true_but_first_matched()
println format("test_else_if_second_true_but_first_matched: %d (expected: 1)", result)
assert result == 1

result = test_else_if_inline()
println format("test_else_if_inline: %d (expected: 3)", result)
assert result == 3

result = test_else_if_short_circuit()
println format("test_else_if_short_circuit: %d (expected: 1)", result)
assert result == 1
assert side_effect_count == 0

result = test_else_if_all_false_no_else()
println format("test_else_if_all_false_no_else: %d (expected: 0)", result)
assert result == 0

result = test_else_if_in_loop()
println format("test_else_if_in_loop: %s (expected: cacbc)", result)
assert result == "cacbc"

result = test_else_if_nested_inner()
println format("test_else_if_nested_inner: %s (expected: inner-b)", result)
assert result == "inner-b"

result = test_else_if_empty_clauses()
println format("test_else_if_empty_clauses: %d (expected: 0)", result)
assert result == 0

result = test_else_if_deep()
println format("test_else_if_deep: %s (expected: xm)", result)
assert result == "xm"

result = test_else_if_in_while()
println format("test_else_if_in_while: %s (expected: cacbc)", result)
assert result == "cacbc"

result = test_else_if_in_foreach()
println format("test_else_if_in_foreach: %s (expected: acbc)", result)
assert result == "acbc"

result = test_else_if_break_continue()
println format("test_else_if_break_continue: %s (expected: 013)", result)
assert result == "013"

result = test_else_if_return_if()
println format("test_else_if_return_if: %s (expected: b)", result)
assert result == "b"

result = test_else_if_return_if_false()
println format("test_else_if_return_if_false: %s (expected: fallback)", result)
assert result == "fallback"

result = test_else_if_strict_truthiness()
println format("test_else_if_strict_truthiness: %d (expected: 4)", result)
assert result == 4

result = test_else_if_sibling_chains()
println format("test_else_if_sibling_chains: %s (expected: jk)", result)
assert result == "jk"

println "All else-if tests passed!"


