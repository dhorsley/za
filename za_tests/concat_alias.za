# concat() slice-aliasing regression (za level).
# concat() is documented as pure: no call may mutate its inputs or any live
# slice sharing their backing. Covers the nested form, the temp-var form,
# read-after-append, and a splice cut/insert round-trip.
# NOTE: assert() is a no-op outside test blocks, so this script counts
# mismatches explicitly and prints a verdict line.

fails = 0

base = []
for i = 0 to 99
    base = concat(base, [i * 1.0])
endfor
on base.len != 100 do fails = fails + 1

q = [1000.0, 1001.0, 1002.0, 1003.0]

# nested form over aliased slices (the original minimap-shadow corruption)
r = concat(concat(base[0:20], q), base[20:])
on r.len != 104 do fails = fails + 1
on r[20] != 1000.0 do fails = fails + 1
on r[23] != 1003.0 do fails = fails + 1
on r[24] != 20.0 do fails = fails + 1
on r[103] != 99.0 do fails = fails + 1
on base[20] != 20.0 do fails = fails + 1

# temp-var form (same hazard, no nesting)
t = concat(base[0:20], q)
r2 = concat(t, base[20:])
on r2.len != 104 do fails = fails + 1
on r2[24] != 20.0 do fails = fails + 1
on base[44] != 44.0 do fails = fails + 1

# read-after form (no nesting at all)
y = concat(base[0:2], [50.0, 51.0])
on y.len != 4 do fails = fails + 1
on y[2] != 50.0 do fails = fails + 1
on base[2] != 2.0 do fails = fails + 1

# splice dance: cut 24 floats at 20, insert quad at 40 (alias-safe order)
s = base[0:100]
cut = concat(s[0:20], s[44:])
on cut.len != 76 do fails = fails + 1
on cut[19] != 19.0 do fails = fails + 1
on cut[20] != 44.0 do fails = fails + 1
tail = concat(q, cut[40:])
ins = concat(cut[0:40], tail)
on ins.len != 80 do fails = fails + 1
on ins[40] != 1000.0 do fails = fails + 1
on ins[43] != 1003.0 do fails = fails + 1
on ins[44] != 64.0 do fails = fails + 1

println format("concat aliasing regression: fails=%v", fails)
