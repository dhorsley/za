doc '
lib/geometry.za — World geometry VBO builders
---------------------------------------------

Pre-computes and uploads terrain, roads, water, beach, and grass
geometry to the GPU. All functions here run once at init time.
'

namespace main

define create_merged_box_vbo(instances)
    num_instances = instances.len / 9
    total_verts = num_instances * 24
    total_floats = total_verts * 3

    verts_ptr = c_alloc(total_floats * 4)
    colors_ptr = c_alloc(total_floats * 4)

    for inst = 0 to num_instances - 1
        base = inst * 9
        ix = instances[base ]
        iy = instances[base + 1]
        iz = instances[base + 2]
        sx = instances[base + 3]
        sy = instances[base + 4]
        sz = instances[base + 5]
        br = instances[base + 6]
        bg = instances[base + 7]
        bb = instances[base + 8]

        # Shaded face colors (fake directional light)
        rf1 = br * SHADE_FRONT;   gf1 = bg * SHADE_FRONT;   bf1 = bb * SHADE_FRONT
        rf2 = br * SHADE_BACK;    gf2 = bg * SHADE_BACK;    bf2 = bb * SHADE_BACK
        rf3 = br * SHADE_LEFT;    gf3 = bg * SHADE_LEFT;    bf3 = bb * SHADE_LEFT
        rf4 = br * SHADE_RIGHT;   gf4 = bg * SHADE_RIGHT;   bf4 = bb * SHADE_RIGHT
        rf5 = br * SHADE_TOP;     gf5 = bg * SHADE_TOP;     bf5 = bb * SHADE_TOP
        rf6 = br * SHADE_BOTTOM;  gf6 = bg * SHADE_BOTTOM;  bf6 = bb * SHADE_BOTTOM

        s = 0.5
        base_vert = inst * 24

        # Front face (+Z)
        c_set_float(verts_ptr, ((base_vert+0)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+0)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+0)*3+2)*4, iz +  s *sz)
        c_set_float(verts_ptr, ((base_vert+1)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+1)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+1)*3+2)*4, iz +  s *sz)
        c_set_float(verts_ptr, ((base_vert+2)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+2)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+2)*3+2)*4, iz +  s *sz)
        c_set_float(verts_ptr, ((base_vert+3)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+3)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+3)*3+2)*4, iz +  s *sz)
        # Back face (-Z)
        c_set_float(verts_ptr, ((base_vert+4)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+4)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+4)*3+2)*4, iz + (-s)*sz)
        c_set_float(verts_ptr, ((base_vert+5)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+5)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+5)*3+2)*4, iz + (-s)*sz)
        c_set_float(verts_ptr, ((base_vert+6)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+6)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+6)*3+2)*4, iz + (-s)*sz)
        c_set_float(verts_ptr, ((base_vert+7)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+7)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+7)*3+2)*4, iz + (-s)*sz)
        # Left face (-X)
        c_set_float(verts_ptr, ((base_vert+8)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+8)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+8)*3+2)*4, iz + (-s)*sz)
        c_set_float(verts_ptr, ((base_vert+9)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+9)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+9)*3+2)*4, iz +  s *sz)
        c_set_float(verts_ptr, ((base_vert+10)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+10)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+10)*3+2)*4, iz +  s *sz)
        c_set_float(verts_ptr, ((base_vert+11)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+11)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+11)*3+2)*4, iz + (-s)*sz)
        # Right face (+X)
        c_set_float(verts_ptr, ((base_vert+12)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+12)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+12)*3+2)*4, iz + (-s)*sz)
        c_set_float(verts_ptr, ((base_vert+13)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+13)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+13)*3+2)*4, iz + (-s)*sz)
        c_set_float(verts_ptr, ((base_vert+14)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+14)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+14)*3+2)*4, iz +  s *sz)
        c_set_float(verts_ptr, ((base_vert+15)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+15)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+15)*3+2)*4, iz +  s *sz)
        # Top face (+Y)
        c_set_float(verts_ptr, ((base_vert+16)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+16)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+16)*3+2)*4, iz + (-s)*sz)
        c_set_float(verts_ptr, ((base_vert+17)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+17)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+17)*3+2)*4, iz +  s *sz)
        c_set_float(verts_ptr, ((base_vert+18)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+18)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+18)*3+2)*4, iz +  s *sz)
        c_set_float(verts_ptr, ((base_vert+19)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+19)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+19)*3+2)*4, iz + (-s)*sz)
        # Bottom face (-Y)
        c_set_float(verts_ptr, ((base_vert+20)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+20)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+20)*3+2)*4, iz + (-s)*sz)
        c_set_float(verts_ptr, ((base_vert+21)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+21)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+21)*3+2)*4, iz + (-s)*sz)
        c_set_float(verts_ptr, ((base_vert+22)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+22)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+22)*3+2)*4, iz +  s *sz)
        c_set_float(verts_ptr, ((base_vert+23)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+23)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+23)*3+2)*4, iz +  s *sz)

        base_color = inst * 24
        for vi = 0 to 3
            c_set_float(colors_ptr, ((base_color+vi)*3+0)*4, rf1)
            c_set_float(colors_ptr, ((base_color+vi)*3+1)*4, gf1)
            c_set_float(colors_ptr, ((base_color+vi)*3+2)*4, bf1)
        endfor
        for vi = 4 to 7
            c_set_float(colors_ptr, ((base_color+vi)*3+0)*4, rf2)
            c_set_float(colors_ptr, ((base_color+vi)*3+1)*4, gf2)
            c_set_float(colors_ptr, ((base_color+vi)*3+2)*4, bf2)
        endfor
        for vi = 8 to 11
            c_set_float(colors_ptr, ((base_color+vi)*3+0)*4, rf3)
            c_set_float(colors_ptr, ((base_color+vi)*3+1)*4, gf3)
            c_set_float(colors_ptr, ((base_color+vi)*3+2)*4, bf3)
        endfor
        for vi = 12 to 15
            c_set_float(colors_ptr, ((base_color+vi)*3+0)*4, rf4)
            c_set_float(colors_ptr, ((base_color+vi)*3+1)*4, gf4)
            c_set_float(colors_ptr, ((base_color+vi)*3+2)*4, bf4)
        endfor
        for vi = 16 to 19
            c_set_float(colors_ptr, ((base_color+vi)*3+0)*4, rf5)
            c_set_float(colors_ptr, ((base_color+vi)*3+1)*4, gf5)
            c_set_float(colors_ptr, ((base_color+vi)*3+2)*4, bf5)
        endfor
        for vi = 20 to 23
            c_set_float(colors_ptr, ((base_color+vi)*3+0)*4, rf6)
            c_set_float(colors_ptr, ((base_color+vi)*3+1)*4, gf6)
            c_set_float(colors_ptr, ((base_color+vi)*3+2)*4, bf6)
        endfor
    endfor

    vbo = upload_vbo(verts_ptr, total_floats * 4)
    color_vbo = upload_vbo(colors_ptr, total_floats * 4)
    return pack_vbo_triple(vbo, color_vbo, total_verts)
end

define draw_merged_vbo(vbo_data)
    vbo = vbo_data[0]
    color_vbo = vbo_data[1]
    total_verts = vbo_data[2]

    glEnableClientState(GL_VERTEX_ARRAY)
    glEnableClientState(GL_COLOR_ARRAY)
    glBindBuffer(GL_ARRAY_BUFFER, vbo)
    glVertexPointer(3, GL_FLOAT, 0, 0)
    glBindBuffer(GL_ARRAY_BUFFER, color_vbo)
    glColorPointer(3, GL_FLOAT, 0, 0)
    glDrawArrays(GL_QUADS, 0, total_verts)
    glDisableClientState(GL_VERTEX_ARRAY)
    glDisableClientState(GL_COLOR_ARRAY)
    glBindBuffer(GL_ARRAY_BUFFER, 0)
end

define create_textured_merged_box_vbo(instances)
    num_instances = instances.len / 9
    total_verts = num_instances * 24
    total_floats = total_verts * 3

    verts_ptr = c_alloc(total_floats * 4)
    tex_ptr = c_alloc(total_verts * 2 * 4)

    for inst = 0 to num_instances - 1
        base = inst * 9
        ix = instances[base ]
        iy = instances[base + 1]
        iz = instances[base + 2]
        sx = instances[base + 3]
        sy = instances[base + 4]
        sz = instances[base + 5]

        s = 0.5
        base_vert = inst * 24

        # Front face (+Z) - 4 verts with UV 0,0 / 1,0 / 1,1 / 0,1
        c_set_float(verts_ptr, ((base_vert+0)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+0)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+0)*3+2)*4, iz +  s *sz)
        c_set_float(tex_ptr, (base_vert+0)*2*4 , 0.0)
        c_set_float(tex_ptr, (base_vert+0)*2*4 + 1*4, 0.0)
        c_set_float(verts_ptr, ((base_vert+1)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+1)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+1)*3+2)*4, iz +  s *sz)
        c_set_float(tex_ptr, (base_vert+1)*2*4 , 1.0)
        c_set_float(tex_ptr, (base_vert+1)*2*4 + 1*4, 0.0)
        c_set_float(verts_ptr, ((base_vert+2)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+2)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+2)*3+2)*4, iz +  s *sz)
        c_set_float(tex_ptr, (base_vert+2)*2*4 , 1.0)
        c_set_float(tex_ptr, (base_vert+2)*2*4 + 1*4, 1.0)
        c_set_float(verts_ptr, ((base_vert+3)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+3)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+3)*3+2)*4, iz +  s *sz)
        c_set_float(tex_ptr, (base_vert+3)*2*4 , 0.0)
        c_set_float(tex_ptr, (base_vert+3)*2*4 + 1*4, 1.0)
        # Back face (-Z)
        c_set_float(verts_ptr, ((base_vert+4)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+4)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+4)*3+2)*4, iz + (-s)*sz)
        c_set_float(tex_ptr, (base_vert+4)*2*4 , 1.0)
        c_set_float(tex_ptr, (base_vert+4)*2*4 + 1*4, 0.0)
        c_set_float(verts_ptr, ((base_vert+5)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+5)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+5)*3+2)*4, iz + (-s)*sz)
        c_set_float(tex_ptr, (base_vert+5)*2*4 , 0.0)
        c_set_float(tex_ptr, (base_vert+5)*2*4 + 1*4, 0.0)
        c_set_float(verts_ptr, ((base_vert+6)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+6)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+6)*3+2)*4, iz + (-s)*sz)
        c_set_float(tex_ptr, (base_vert+6)*2*4 , 0.0)
        c_set_float(tex_ptr, (base_vert+6)*2*4 + 1*4, 1.0)
        c_set_float(verts_ptr, ((base_vert+7)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+7)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+7)*3+2)*4, iz + (-s)*sz)
        c_set_float(tex_ptr, (base_vert+7)*2*4 , 1.0)
        c_set_float(tex_ptr, (base_vert+7)*2*4 + 1*4, 1.0)
        # Left face (-X)
        c_set_float(verts_ptr, ((base_vert+8)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+8)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+8)*3+2)*4, iz + (-s)*sz)
        c_set_float(tex_ptr, (base_vert+8)*2*4 , 0.0)
        c_set_float(tex_ptr, (base_vert+8)*2*4 + 1*4, 0.0)
        c_set_float(verts_ptr, ((base_vert+9)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+9)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+9)*3+2)*4, iz +  s *sz)
        c_set_float(tex_ptr, (base_vert+9)*2*4 , 1.0)
        c_set_float(tex_ptr, (base_vert+9)*2*4 + 1*4, 0.0)
        c_set_float(verts_ptr, ((base_vert+10)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+10)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+10)*3+2)*4, iz +  s *sz)
        c_set_float(tex_ptr, (base_vert+10)*2*4 , 1.0)
        c_set_float(tex_ptr, (base_vert+10)*2*4 + 1*4, 1.0)
        c_set_float(verts_ptr, ((base_vert+11)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+11)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+11)*3+2)*4, iz + (-s)*sz)
        c_set_float(tex_ptr, (base_vert+11)*2*4 , 0.0)
        c_set_float(tex_ptr, (base_vert+11)*2*4 + 1*4, 1.0)
        # Right face (+X)
        c_set_float(verts_ptr, ((base_vert+12)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+12)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+12)*3+2)*4, iz +  s *sz)
        c_set_float(tex_ptr, (base_vert+12)*2*4 , 0.0)
        c_set_float(tex_ptr, (base_vert+12)*2*4 + 1*4, 0.0)
        c_set_float(verts_ptr, ((base_vert+13)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+13)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+13)*3+2)*4, iz + (-s)*sz)
        c_set_float(tex_ptr, (base_vert+13)*2*4 , 1.0)
        c_set_float(tex_ptr, (base_vert+13)*2*4 + 1*4, 0.0)
        c_set_float(verts_ptr, ((base_vert+14)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+14)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+14)*3+2)*4, iz +  s *sz)
        c_set_float(tex_ptr, (base_vert+14)*2*4 , 1.0)
        c_set_float(tex_ptr, (base_vert+14)*2*4 + 1*4, 1.0)
        c_set_float(verts_ptr, ((base_vert+15)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+15)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+15)*3+2)*4, iz +  s *sz)
        c_set_float(tex_ptr, (base_vert+15)*2*4 , 0.0)
        c_set_float(tex_ptr, (base_vert+15)*2*4 + 1*4, 1.0)
        # Top face (+Y)
        c_set_float(verts_ptr, ((base_vert+16)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+16)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+16)*3+2)*4, iz + (-s)*sz)
        c_set_float(tex_ptr, (base_vert+16)*2*4 , 0.0)
        c_set_float(tex_ptr, (base_vert+16)*2*4 + 1*4, 0.0)
        c_set_float(verts_ptr, ((base_vert+17)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+17)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+17)*3+2)*4, iz +  s *sz)
        c_set_float(tex_ptr, (base_vert+17)*2*4 , 0.0)
        c_set_float(tex_ptr, (base_vert+17)*2*4 + 1*4, 1.0)
        c_set_float(verts_ptr, ((base_vert+18)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+18)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+18)*3+2)*4, iz +  s *sz)
        c_set_float(tex_ptr, (base_vert+18)*2*4 , 1.0)
        c_set_float(tex_ptr, (base_vert+18)*2*4 + 1*4, 1.0)
        c_set_float(verts_ptr, ((base_vert+19)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+19)*3+1)*4, iy +  s *sy)
        c_set_float(verts_ptr, ((base_vert+19)*3+2)*4, iz + (-s)*sz)
        c_set_float(tex_ptr, (base_vert+19)*2*4 , 1.0)
        c_set_float(tex_ptr, (base_vert+19)*2*4 + 1*4, 0.0)
        # Bottom face (-Y)
        c_set_float(verts_ptr, ((base_vert+20)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+20)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+20)*3+2)*4, iz +  s *sz)
        c_set_float(tex_ptr, (base_vert+20)*2*4 , 0.0)
        c_set_float(tex_ptr, (base_vert+20)*2*4 + 1*4, 0.0)
        c_set_float(verts_ptr, ((base_vert+21)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+21)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+21)*3+2)*4, iz +  s *sz)
        c_set_float(tex_ptr, (base_vert+21)*2*4 , 1.0)
        c_set_float(tex_ptr, (base_vert+21)*2*4 + 1*4, 0.0)
        c_set_float(verts_ptr, ((base_vert+22)*3+0)*4, ix +  s *sx)
        c_set_float(verts_ptr, ((base_vert+22)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+22)*3+2)*4, iz + (-s)*sz)
        c_set_float(tex_ptr, (base_vert+22)*2*4 , 1.0)
        c_set_float(tex_ptr, (base_vert+22)*2*4 + 1*4, 1.0)
        c_set_float(verts_ptr, ((base_vert+23)*3+0)*4, ix + (-s)*sx)
        c_set_float(verts_ptr, ((base_vert+23)*3+1)*4, iy + (-s)*sy)
        c_set_float(verts_ptr, ((base_vert+23)*3+2)*4, iz + (-s)*sz)
        c_set_float(tex_ptr, (base_vert+23)*2*4 , 0.0)
        c_set_float(tex_ptr, (base_vert+23)*2*4 + 1*4, 1.0)
    endfor

    vbo = upload_vbo(verts_ptr, total_floats * 4)
    tex_vbo = upload_vbo(tex_ptr, total_verts * 2 * 4)
    return pack_vbo_triple(vbo, tex_vbo, total_verts)
    return result
end

define draw_textured_merged_vbo(vbo_data, texture_id)
    vbo = vbo_data[0]
    tex_vbo = vbo_data[1]
    total_verts = vbo_data[2]

    glEnable(GL_TEXTURE_2D)
    glBindTexture(GL_TEXTURE_2D, texture_id)
    glTexEnvi(GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_MODULATE)

    glEnableClientState(GL_VERTEX_ARRAY)
    glEnableClientState(GL_TEXTURE_COORD_ARRAY)
    glBindBuffer(GL_ARRAY_BUFFER, vbo)
    glVertexPointer(3, GL_FLOAT, 0, 0)
    glBindBuffer(GL_ARRAY_BUFFER, tex_vbo)
    glTexCoordPointer(2, GL_FLOAT, 0, 0)

    glColor3f(1.0, 1.0, 1.0)
    glDrawArrays(GL_QUADS, 0, total_verts)

    glDisableClientState(GL_VERTEX_ARRAY)
    glDisableClientState(GL_TEXTURE_COORD_ARRAY)
    glBindTexture(GL_TEXTURE_2D, 0)
    glDisable(GL_TEXTURE_2D)
    glBindBuffer(GL_ARRAY_BUFFER, 0)
end

# Build a round-edged water polygon VBO from flat instance data.
# Each water instance gets a custom circle mesh with UVs.
define create_water_vbo(instances)
    num_instances = instances.len / 9
    on num_instances == 0 do return
    segments = 16
    tile_size = 4.0
    stride = 9

    # Count large vs small
    large_n = 0
    small_n = 0
    for inst = 0 to num_instances - 1
        sx = instances[inst * 9 + 3]
        sz = instances[inst * 9 + 5]
        if sx > 15.0 || sz > 15.0
            large_n = large_n + 1
        else
            small_n = small_n + 1
        endif
    endfor
    @water_large_count = large_n
    @water_small_count = small_n

    # Build large VBO (interleaved: pos3 + tex2 + col4)
    if large_n > 0
        large_bytes = large_n * 4 * stride * 4
        large_ptr = c_alloc(large_bytes)
        v = 0
        for inst = 0 to num_instances - 1
            base = inst * 9
            sx = instances[base + 3]
            sz = instances[base + 5]
            if sx <= 15.0 && sz <= 15.0
                continue
            endif
            ix = instances[base]
            iy = instances[base + 1]
            iz = instances[base + 2]
            top_y = iy + instances[base + 4] * 0.5 + inst * 0.0002
            hx = sx * 0.5
            hz = sz * 0.5
            us = (sx / tile_size) * 2.0
            vs = (sz / tile_size) * 2.0
            c_set_float(large_ptr, v * stride * 4     , ix - hx)
            c_set_float(large_ptr, v * stride * 4 +  4, top_y)
            c_set_float(large_ptr, v * stride * 4 +  8, iz + hz)
            c_set_float(large_ptr, v * stride * 4 + 12, 0.0)
            c_set_float(large_ptr, v * stride * 4 + 16, vs)
            c_set_float(large_ptr, v * stride * 4 + 20, 0.5)
            c_set_float(large_ptr, v * stride * 4 + 24, 0.75)
            c_set_float(large_ptr, v * stride * 4 + 28, 0.85)
            c_set_float(large_ptr, v * stride * 4 + 32, 0.85)
            v = v + 1
            c_set_float(large_ptr, v * stride * 4     , ix + hx)
            c_set_float(large_ptr, v * stride * 4 +  4, top_y)
            c_set_float(large_ptr, v * stride * 4 +  8, iz + hz)
            c_set_float(large_ptr, v * stride * 4 + 12, us)
            c_set_float(large_ptr, v * stride * 4 + 16, vs)
            c_set_float(large_ptr, v * stride * 4 + 20, 0.5)
            c_set_float(large_ptr, v * stride * 4 + 24, 0.75)
            c_set_float(large_ptr, v * stride * 4 + 28, 0.85)
            c_set_float(large_ptr, v * stride * 4 + 32, 0.85)
            v = v + 1
            c_set_float(large_ptr, v * stride * 4     , ix + hx)
            c_set_float(large_ptr, v * stride * 4 +  4, top_y)
            c_set_float(large_ptr, v * stride * 4 +  8, iz - hz)
            c_set_float(large_ptr, v * stride * 4 + 12, us)
            c_set_float(large_ptr, v * stride * 4 + 16, 0.0)
            c_set_float(large_ptr, v * stride * 4 + 20, 0.5)
            c_set_float(large_ptr, v * stride * 4 + 24, 0.75)
            c_set_float(large_ptr, v * stride * 4 + 28, 0.85)
            c_set_float(large_ptr, v * stride * 4 + 32, 0.85)
            v = v + 1
            c_set_float(large_ptr, v * stride * 4     , ix - hx)
            c_set_float(large_ptr, v * stride * 4 +  4, top_y)
            c_set_float(large_ptr, v * stride * 4 +  8, iz - hz)
            c_set_float(large_ptr, v * stride * 4 + 12, 0.0)
            c_set_float(large_ptr, v * stride * 4 + 16, 0.0)
            c_set_float(large_ptr, v * stride * 4 + 20, 0.5)
            c_set_float(large_ptr, v * stride * 4 + 24, 0.75)
            c_set_float(large_ptr, v * stride * 4 + 28, 0.85)
            c_set_float(large_ptr, v * stride * 4 + 32, 0.85)
            v = v + 1
        endfor
        @water_large_vbo = gl_gen_buffer()
        glBindBuffer(GL_ARRAY_BUFFER, water_large_vbo)
        glBufferData(GL_ARRAY_BUFFER, large_bytes, large_ptr, GL_STATIC_DRAW)
        glBindBuffer(GL_ARRAY_BUFFER, 0)
        c_free(large_ptr)
    endif

    if small_n > 0
        verts_per_inst = segments + 2
        small_bytes = small_n * verts_per_inst * stride * 4
        small_ptr = c_alloc(small_bytes)
        @water_small_offsets = []
        @water_small_positions = []
        v = 0
        for inst = 0 to num_instances - 1
            base = inst * 9
            sx = instances[base + 3]
            sz = instances[base + 5]
            if sx > 15.0 || sz > 15.0
                continue
            endif
            @water_small_offsets = concat(water_small_offsets, [v])
            ix = instances[base]
            iy = instances[base + 1]
            iz = instances[base + 2]
            hx = sx * 0.5
            hz = sz * 0.5
            @water_small_positions = concat(water_small_positions, [ix, iz, max([hx, hz])])
            top_y = iy + instances[base + 4] * 0.5 + inst * 0.0002
            hx = sx * 0.5
            hz = sz * 0.5
            us = sx / tile_size
            vs = sz / tile_size
            c_set_float(small_ptr, v * stride * 4     , ix)
            c_set_float(small_ptr, v * stride * 4 +  4, top_y)
            c_set_float(small_ptr, v * stride * 4 +  8, iz)
            c_set_float(small_ptr, v * stride * 4 + 12, 0.5 * us)
            c_set_float(small_ptr, v * stride * 4 + 16, 0.5 * vs)
            c_set_float(small_ptr, v * stride * 4 + 20, 1.0)
            c_set_float(small_ptr, v * stride * 4 + 24, 1.0)
            c_set_float(small_ptr, v * stride * 4 + 28, 1.0)
            c_set_float(small_ptr, v * stride * 4 + 32, 0.8)
            v = v + 1
            for s = 0 to segments
                angle = s * 6.283185 / segments
                ca = cos(angle)
                sa = sin(angle)
                px = ix + ca * hx
                pz = iz + sa * hz
                pu = (0.5 + ca * 0.5) * us
                pv = (0.5 + sa * 0.5) * vs
                c_set_float(small_ptr, v * stride * 4     , px)
                c_set_float(small_ptr, v * stride * 4 +  4, top_y)
                c_set_float(small_ptr, v * stride * 4 +  8, pz)
                c_set_float(small_ptr, v * stride * 4 + 12, pu)
                c_set_float(small_ptr, v * stride * 4 + 16, pv)
                c_set_float(small_ptr, v * stride * 4 + 20, 1.0)
                c_set_float(small_ptr, v * stride * 4 + 24, 1.0)
                c_set_float(small_ptr, v * stride * 4 + 28, 1.0)
                c_set_float(small_ptr, v * stride * 4 + 32, 0.0)
                v = v + 1
            endfor
        endfor
        @water_small_vbo = gl_gen_buffer()
        glBindBuffer(GL_ARRAY_BUFFER, water_small_vbo)
        glBufferData(GL_ARRAY_BUFFER, small_bytes, small_ptr, GL_STATIC_DRAW)
        glBindBuffer(GL_ARRAY_BUFFER, 0)
        c_free(small_ptr)
    endif
end

define draw_water_vbo(texture_id, time, planes, use_culling)
    if water_large_count == 0 && water_small_count == 0 && moat_num_verts == 0
        return
    endif
    glDisable(GL_LIGHTING)
    glEnable(GL_BLEND)
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA)
    glEnable(GL_TEXTURE_2D)
    glBindTexture(GL_TEXTURE_2D, texture_id)
    glTexEnvi(GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_MODULATE)
    glDisable(GL_CULL_FACE)

    scroll_u = time * 0.02
    scroll_v = time * 0.05
    glMatrixMode(GL_TEXTURE)
    glPushMatrix()
    glLoadIdentity()
    glTranslatef(scroll_u, scroll_v, 0.0)
    glMatrixMode(GL_MODELVIEW)

    # Moat boundary water with rolling surf (dynamic VBO, CPU-updated per frame)
    draw_moat_waves(time)

    # Ponds and small water blobs (static small VBO)
    if water_small_count > 0
        stride_bytes = 9 * 4
        glEnableClientState(GL_VERTEX_ARRAY)
        glEnableClientState(GL_TEXTURE_COORD_ARRAY)
        glEnableClientState(GL_COLOR_ARRAY)
        glBindBuffer(GL_ARRAY_BUFFER, water_small_vbo)
        glVertexPointer(3, GL_FLOAT, stride_bytes, 0)
        glTexCoordPointer(2, GL_FLOAT, stride_bytes, 12)
        glColorPointer(4, GL_FLOAT, stride_bytes, 20)
        verts_per_inst = 18
        for i = 0 to water_small_count - 1
            if use_culling
                wx = water_small_positions[i * 3]
                wz = water_small_positions[i * 3 + 1]
                wr = water_small_positions[i * 3 + 2]
                if !sphere_in_frustum(wx, 0.0, wz, wr, planes)
                    continue
                endif
            endif
            glDrawArrays(GL_TRIANGLE_FAN, water_small_offsets[i], verts_per_inst)
        endfor
        glDisableClientState(GL_VERTEX_ARRAY)
        glDisableClientState(GL_TEXTURE_COORD_ARRAY)
        glDisableClientState(GL_COLOR_ARRAY)
        glBindBuffer(GL_ARRAY_BUFFER, 0)
    endif

    glDisableClientState(GL_VERTEX_ARRAY)
    glDisableClientState(GL_TEXTURE_COORD_ARRAY)
    glDisableClientState(GL_COLOR_ARRAY)
    glBindBuffer(GL_ARRAY_BUFFER, 0)

    glMatrixMode(GL_TEXTURE)
    glPopMatrix()
    glMatrixMode(GL_MODELVIEW)

    glBindTexture(GL_TEXTURE_2D, 0)
    glDisable(GL_TEXTURE_2D)
    glDisable(GL_BLEND)
    glEnable(GL_LIGHTING)
    glEnable(GL_CULL_FACE)
end

# Build a static VBO for moat waves once at init.
# The vertex shader animates position; CPU only uploads u_time uniform.
define init_moat_wave_vbo()
    long_segs = 25
    short_segs = 2
    verts_per_strip = long_segs * short_segs * 4
    @moat_num_verts = 4 * verts_per_strip
    stride = 7
    data_ptr = c_alloc(moat_num_verts * stride * 4)
    v = 0
    for strip = 0 to 3
        base = strip * 9
        cx = moat_instances[base]
        cz = moat_instances[base + 2]
        sx = moat_instances[base + 3]
        sz = moat_instances[base + 5]
        hx = sx * 0.5
        hz = sz * 0.5
        xmin = cx - hx
        zmin = cz - hz
        us = (sx / 4.0) * 2.0
        vs = (sz / 4.0) * 2.0
        is_horiz = sx > sz
        push_sign = 1.0
        if is_horiz
            if cz > 0
                push_sign = -1.0
            endif
            cell_x = sx / 25.0
            cell_z = sz / 2.0
            for j = 0 to short_segs - 1
                for i = 0 to long_segs - 1
                    x0 = xmin + i * cell_x
                    x1 = xmin + (i + 1) * cell_x
                    z0 = zmin + j * cell_z
                    z1 = zmin + (j + 1) * cell_z
                    xs = [x0, x0, x1, x1]
                    zs = [z0, z1, z1, z0]
                    for c = 0 to 3
                        x = xs[c]
                        z = zs[c]
                        u = ((x - xmin) / sx) * us
                        tv = ((z - zmin) / sz) * vs
                        offset = v * stride * 4
                        c_set_float(data_ptr, offset + 0, x)
                        c_set_float(data_ptr, offset + 4, 0.02)
                        c_set_float(data_ptr, offset + 8, z)
                        c_set_float(data_ptr, offset + 12, u)
                        c_set_float(data_ptr, offset + 16, tv)
                        c_set_float(data_ptr, offset + 20, 1.0)
                        c_set_float(data_ptr, offset + 24, push_sign)
                        v = v + 1
                    endfor
                endfor
            endfor
        else
            if cx > 0
                push_sign = -1.0
            endif
            cell_x = sx / 2.0
            cell_z = sz / 25.0
            for j = 0 to short_segs - 1
                for i = 0 to long_segs - 1
                    x0 = xmin + j * cell_x
                    x1 = xmin + (j + 1) * cell_x
                    z0 = zmin + i * cell_z
                    z1 = zmin + (i + 1) * cell_z
                    xs = [x0, x0, x1, x1]
                    zs = [z0, z1, z1, z0]
                    for c = 0 to 3
                        x = xs[c]
                        z = zs[c]
                        u = ((x - xmin) / sx) * us
                        tv = ((z - zmin) / sz) * vs
                        offset = v * stride * 4
                        c_set_float(data_ptr, offset + 0, x)
                        c_set_float(data_ptr, offset + 4, 0.02)
                        c_set_float(data_ptr, offset + 8, z)
                        c_set_float(data_ptr, offset + 12, u)
                        c_set_float(data_ptr, offset + 16, tv)
                        c_set_float(data_ptr, offset + 20, 0.0)
                        c_set_float(data_ptr, offset + 24, push_sign)
                        v = v + 1
                    endfor
                endfor
            endfor
        endif
    endfor
    @moat_vbo = gl_gen_buffer()
    glBindBuffer(GL_ARRAY_BUFFER, moat_vbo)
    glBufferData(GL_ARRAY_BUFFER, moat_num_verts * stride * 4, data_ptr, GL_STATIC_DRAW)
    glBindBuffer(GL_ARRAY_BUFFER, 0)
    c_free(data_ptr)
end

# Draw moat waves using a GPU vertex shader (no CPU sin/cos per frame).
define draw_moat_waves(time)
    on moat_num_verts == 0 do return
    on moat_program == 0 do return
    glUseProgram(moat_program)
    glUniform1f(moat_u_time, time)
    glUniform1f(moat_u_world_half, WORLD_HALF)
    glBindBuffer(GL_ARRAY_BUFFER, moat_vbo)
    stride_bytes = 7 * 4
    glEnableVertexAttribArray(0)
    glEnableVertexAttribArray(1)
    glEnableVertexAttribArray(2)
    glEnableVertexAttribArray(3)
    glVertexAttribPointer(0, 3, GL_FLOAT, 0, stride_bytes, 0)
    glVertexAttribPointer(1, 2, GL_FLOAT, 0, stride_bytes, 12)
    glVertexAttribPointer(2, 1, GL_FLOAT, 0, stride_bytes, 20)
    glVertexAttribPointer(3, 1, GL_FLOAT, 0, stride_bytes, 24)
    glDrawArrays(GL_QUADS, 0, moat_num_verts)
    glDisableVertexAttribArray(0)
    glDisableVertexAttribArray(1)
    glDisableVertexAttribArray(2)
    glDisableVertexAttribArray(3)
    glBindBuffer(GL_ARRAY_BUFFER, 0)
    glUseProgram(0)
end

# Precompute the entire sandy beach geometry at startup.
# Replaces per-frame CPU recomputation that was the #1 profiler cost.
define init_beach_vbo()
    outer = WORLD_HALF + 6.0
    inner = WORLD_HALF - 3.0
    span = outer * 2.0
    segs = as_int(span / 4.0)
    @beach_num_verts = segs * 4 * 4
    @beach_data_ptr = c_alloc(beach_num_verts * 5 * 4)
    @beach_vbo = gl_gen_buffer()

    y = 0.01
    seg_step = span / segs
    stride = 5
    v = 0

    # North strip
    for i = 0 to segs - 1
        x0 = -outer + i * seg_step
        x1 = -outer + (i + 1) * seg_step
        jz0 = sin(x0 * 0.7 + 4.2) * 1.8 + cos(x0 * 1.1 + 2.7) * 0.7
        jz1 = sin(x1 * 0.7 + 4.2) * 1.8 + cos(x1 * 1.1 + 2.7) * 0.7
        on jz0 > 0.0 do jz0 = 0.0
        on jz1 > 0.0 do jz1 = 0.0
        z_in0 = -inner + jz0
        z_in1 = -inner + jz1
        c_set_float(beach_data_ptr, (v * stride + 0) * 4, x0)
        c_set_float(beach_data_ptr, (v * stride + 1) * 4, y)
        c_set_float(beach_data_ptr, (v * stride + 2) * 4, -outer)
        c_set_float(beach_data_ptr, (v * stride + 3) * 4, i * 1.0)
        c_set_float(beach_data_ptr, (v * stride + 4) * 4, 0.0)
        v = v + 1
        c_set_float(beach_data_ptr, (v * stride + 0) * 4, x1)
        c_set_float(beach_data_ptr, (v * stride + 1) * 4, y)
        c_set_float(beach_data_ptr, (v * stride + 2) * 4, -outer)
        c_set_float(beach_data_ptr, (v * stride + 3) * 4, (i + 1) * 1.0)
        c_set_float(beach_data_ptr, (v * stride + 4) * 4, 0.0)
        v = v + 1
        c_set_float(beach_data_ptr, (v * stride + 0) * 4, x1)
        c_set_float(beach_data_ptr, (v * stride + 1) * 4, y)
        c_set_float(beach_data_ptr, (v * stride + 2) * 4, z_in1)
        c_set_float(beach_data_ptr, (v * stride + 3) * 4, (i + 1) * 1.0)
        c_set_float(beach_data_ptr, (v * stride + 4) * 4, 3.0)
        v = v + 1
        c_set_float(beach_data_ptr, (v * stride + 0) * 4, x0)
        c_set_float(beach_data_ptr, (v * stride + 1) * 4, y)
        c_set_float(beach_data_ptr, (v * stride + 2) * 4, z_in0)
        c_set_float(beach_data_ptr, (v * stride + 3) * 4, i * 1.0)
        c_set_float(beach_data_ptr, (v * stride + 4) * 4, 3.0)
        v = v + 1
    endfor
    # South strip
    for i = 0 to segs - 1
        x0 = -outer + i * seg_step
        x1 = -outer + (i + 1) * seg_step
        jz0 = sin(x0 * 0.7 + 0.9) * 1.8 + cos(x0 * 1.1 + 5.3) * 0.7
        jz1 = sin(x1 * 0.7 + 0.9) * 1.8 + cos(x1 * 1.1 + 5.3) * 0.7
        on jz0 < 0.0 do jz0 = 0.0
        on jz1 < 0.0 do jz1 = 0.0
        z_in0 = inner + jz0
        z_in1 = inner + jz1
        c_set_float(beach_data_ptr, (v * stride + 0) * 4, x0)
        c_set_float(beach_data_ptr, (v * stride + 1) * 4, y)
        c_set_float(beach_data_ptr, (v * stride + 2) * 4, z_in0)
        c_set_float(beach_data_ptr, (v * stride + 3) * 4, i * 1.0)
        c_set_float(beach_data_ptr, (v * stride + 4) * 4, 0.0)
        v = v + 1
        c_set_float(beach_data_ptr, (v * stride + 0) * 4, x1)
        c_set_float(beach_data_ptr, (v * stride + 1) * 4, y)
        c_set_float(beach_data_ptr, (v * stride + 2) * 4, z_in1)
        c_set_float(beach_data_ptr, (v * stride + 3) * 4, (i + 1) * 1.0)
        c_set_float(beach_data_ptr, (v * stride + 4) * 4, 0.0)
        v = v + 1
        c_set_float(beach_data_ptr, (v * stride + 0) * 4, x1)
        c_set_float(beach_data_ptr, (v * stride + 1) * 4, y)
        c_set_float(beach_data_ptr, (v * stride + 2) * 4, outer)
        c_set_float(beach_data_ptr, (v * stride + 3) * 4, (i + 1) * 1.0)
        c_set_float(beach_data_ptr, (v * stride + 4) * 4, 3.0)
        v = v + 1
        c_set_float(beach_data_ptr, (v * stride + 0) * 4, x0)
        c_set_float(beach_data_ptr, (v * stride + 1) * 4, y)
        c_set_float(beach_data_ptr, (v * stride + 2) * 4, outer)
        c_set_float(beach_data_ptr, (v * stride + 3) * 4, i * 1.0)
        c_set_float(beach_data_ptr, (v * stride + 4) * 4, 3.0)
        v = v + 1
    endfor
    # West strip
    for i = 0 to segs - 1
        z0 = -outer + i * seg_step
        z1 = -outer + (i + 1) * seg_step
        jx0 = sin(z0 * 0.7 + 1.3) * 1.8 + cos(z0 * 1.1 + 3.1) * 0.7
        jx1 = sin(z1 * 0.7 + 1.3) * 1.8 + cos(z1 * 1.1 + 3.1) * 0.7
        on jx0 > 0.0 do jx0 = 0.0
        on jx1 > 0.0 do jx1 = 0.0
        x_in0 = -inner + jx0
        x_in1 = -inner + jx1
        c_set_float(beach_data_ptr, (v * stride + 0) * 4, -outer)
        c_set_float(beach_data_ptr, (v * stride + 1) * 4, y)
        c_set_float(beach_data_ptr, (v * stride + 2) * 4, z0)
        c_set_float(beach_data_ptr, (v * stride + 3) * 4, 0.0)
        c_set_float(beach_data_ptr, (v * stride + 4) * 4, i * 1.0)
        v = v + 1
        c_set_float(beach_data_ptr, (v * stride + 0) * 4, -outer)
        c_set_float(beach_data_ptr, (v * stride + 1) * 4, y)
        c_set_float(beach_data_ptr, (v * stride + 2) * 4, z1)
        c_set_float(beach_data_ptr, (v * stride + 3) * 4, 0.0)
        c_set_float(beach_data_ptr, (v * stride + 4) * 4, (i + 1) * 1.0)
        v = v + 1
        c_set_float(beach_data_ptr, (v * stride + 0) * 4, x_in1)
        c_set_float(beach_data_ptr, (v * stride + 1) * 4, y)
        c_set_float(beach_data_ptr, (v * stride + 2) * 4, z1)
        c_set_float(beach_data_ptr, (v * stride + 3) * 4, 3.0)
        c_set_float(beach_data_ptr, (v * stride + 4) * 4, (i + 1) * 1.0)
        v = v + 1
        c_set_float(beach_data_ptr, (v * stride + 0) * 4, x_in0)
        c_set_float(beach_data_ptr, (v * stride + 1) * 4, y)
        c_set_float(beach_data_ptr, (v * stride + 2) * 4, z0)
        c_set_float(beach_data_ptr, (v * stride + 3) * 4, 3.0)
        c_set_float(beach_data_ptr, (v * stride + 4) * 4, i * 1.0)
        v = v + 1
    endfor
    # East strip
    for i = 0 to segs - 1
        z0 = -outer + i * seg_step
        z1 = -outer + (i + 1) * seg_step
        jx0 = sin(z0 * 0.7 + 2.1) * 1.8 + cos(z0 * 1.1 + 0.5) * 0.7
        jx1 = sin(z1 * 0.7 + 2.1) * 1.8 + cos(z1 * 1.1 + 0.5) * 0.7
        on jx0 < 0.0 do jx0 = 0.0
        on jx1 < 0.0 do jx1 = 0.0
        x_in0 = inner + jx0
        x_in1 = inner + jx1
        c_set_float(beach_data_ptr, (v * stride + 0) * 4, x_in0)
        c_set_float(beach_data_ptr, (v * stride + 1) * 4, y)
        c_set_float(beach_data_ptr, (v * stride + 2) * 4, z0)
        c_set_float(beach_data_ptr, (v * stride + 3) * 4, 0.0)
        c_set_float(beach_data_ptr, (v * stride + 4) * 4, i * 1.0)
        v = v + 1
        c_set_float(beach_data_ptr, (v * stride + 0) * 4, x_in1)
        c_set_float(beach_data_ptr, (v * stride + 1) * 4, y)
        c_set_float(beach_data_ptr, (v * stride + 2) * 4, z1)
        c_set_float(beach_data_ptr, (v * stride + 3) * 4, 0.0)
        c_set_float(beach_data_ptr, (v * stride + 4) * 4, (i + 1) * 1.0)
        v = v + 1
        c_set_float(beach_data_ptr, (v * stride + 0) * 4, outer)
        c_set_float(beach_data_ptr, (v * stride + 1) * 4, y)
        c_set_float(beach_data_ptr, (v * stride + 2) * 4, z1)
        c_set_float(beach_data_ptr, (v * stride + 3) * 4, 3.0)
        c_set_float(beach_data_ptr, (v * stride + 4) * 4, (i + 1) * 1.0)
        v = v + 1
        c_set_float(beach_data_ptr, (v * stride + 0) * 4, outer)
        c_set_float(beach_data_ptr, (v * stride + 1) * 4, y)
        c_set_float(beach_data_ptr, (v * stride + 2) * 4, z0)
        c_set_float(beach_data_ptr, (v * stride + 3) * 4, 3.0)
        c_set_float(beach_data_ptr, (v * stride + 4) * 4, i * 1.0)
        v = v + 1
    endfor

    glBindBuffer(GL_ARRAY_BUFFER, beach_vbo)
    glBufferData(GL_ARRAY_BUFFER, beach_num_verts * 5 * 4, beach_data_ptr, GL_STATIC_DRAW)
    glBindBuffer(GL_ARRAY_BUFFER, 0)
end

define draw_beach(sand_tex_id)
    on sand_tex_id == 0 do return
    glDisable(GL_CULL_FACE)
    glDisable(GL_LIGHTING)
    glEnable(GL_TEXTURE_2D)
    glBindTexture(GL_TEXTURE_2D, sand_tex_id)
    glTexEnvi(GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_MODULATE)
    glColor4f(1.0, 1.0, 1.0, 1.0)
    glBindBuffer(GL_ARRAY_BUFFER, beach_vbo)
    glEnableClientState(GL_VERTEX_ARRAY)
    glEnableClientState(GL_TEXTURE_COORD_ARRAY)
    glVertexPointer(3, GL_FLOAT, 20, 0)
    glTexCoordPointer(2, GL_FLOAT, 20, 12)
    glDrawArrays(GL_QUADS, 0, beach_num_verts)
    glDisableClientState(GL_VERTEX_ARRAY)
    glDisableClientState(GL_TEXTURE_COORD_ARRAY)
    glBindBuffer(GL_ARRAY_BUFFER, 0)
    glBindTexture(GL_TEXTURE_2D, 0)
    glDisable(GL_TEXTURE_2D)
    glEnable(GL_LIGHTING)
    glEnable(GL_CULL_FACE)
end

define create_road_vbo(instances)
    num_instances = instances.len / 9
    on num_instances == 0 do return pack_vbo_triple(0, 0, 0)
    total_verts = num_instances * 4
    verts_ptr = c_alloc(total_verts * 3 * 4)
    tex_ptr = c_alloc(total_verts * 2 * 4)
    tile_size = 4.0
    for inst = 0 to num_instances - 1
        base = inst * 9
        ix = instances[base]
        iy = instances[base + 1]
        iz = instances[base + 2]
        sx = instances[base + 3]
        sy = instances[base + 4]
        sz = instances[base + 5]
        # Tiny per-instance Y offset prevents coplanar road surfaces from
        # z-fighting at intersections.
        top_y = iy + sy * 0.5 + inst * 0.0002
        hx = sx * 0.5
        hz = sz * 0.5
        u_scale = sx / tile_size
        v_scale = sz / tile_size
        v0 = inst * 4
        # Top face quad, counter-clockwise when viewed from above (normal +Y)
        c_set_float(verts_ptr, (v0 * 3 + 0) * 4, ix - hx)
        c_set_float(verts_ptr, (v0 * 3 + 1) * 4, top_y)
        c_set_float(verts_ptr, (v0 * 3 + 2) * 4, iz + hz)
        c_set_float(tex_ptr, (v0 * 2 + 0) * 4, 0.0)
        c_set_float(tex_ptr, (v0 * 2 + 1) * 4, v_scale)

        c_set_float(verts_ptr, ((v0 + 1) * 3 + 0) * 4, ix + hx)
        c_set_float(verts_ptr, ((v0 + 1) * 3 + 1) * 4, top_y)
        c_set_float(verts_ptr, ((v0 + 1) * 3 + 2) * 4, iz + hz)
        c_set_float(tex_ptr, ((v0 + 1) * 2 + 0) * 4, u_scale)
        c_set_float(tex_ptr, ((v0 + 1) * 2 + 1) * 4, v_scale)

        c_set_float(verts_ptr, ((v0 + 2) * 3 + 0) * 4, ix + hx)
        c_set_float(verts_ptr, ((v0 + 2) * 3 + 1) * 4, top_y)
        c_set_float(verts_ptr, ((v0 + 2) * 3 + 2) * 4, iz - hz)
        c_set_float(tex_ptr, ((v0 + 2) * 2 + 0) * 4, u_scale)
        c_set_float(tex_ptr, ((v0 + 2) * 2 + 1) * 4, 0.0)

        c_set_float(verts_ptr, ((v0 + 3) * 3 + 0) * 4, ix - hx)
        c_set_float(verts_ptr, ((v0 + 3) * 3 + 1) * 4, top_y)
        c_set_float(verts_ptr, ((v0 + 3) * 3 + 2) * 4, iz - hz)
        c_set_float(tex_ptr, ((v0 + 3) * 2 + 0) * 4, 0.0)
        c_set_float(tex_ptr, ((v0 + 3) * 2 + 1) * 4, 0.0)
    endfor
    vbo = upload_vbo(verts_ptr, total_verts * 3 * 4)
    tex_vbo = upload_vbo(tex_ptr, total_verts * 2 * 4)
    return pack_vbo_triple(vbo, tex_vbo, total_verts)
end

define point_inside_any_road(px, pz, instances, exclude_index)
    num_instances = instances.len / 9
    for other = 0 to num_instances - 1
        continue if other == exclude_index
        ob = other * 9
        ox = instances[ob]
        oz = instances[ob + 2]
        osx = instances[ob + 3]
        osz = instances[ob + 5]
        ohx = osx * 0.5
        ohz = osz * 0.5
        if px >= ox - ohx && px <= ox + ohx && pz >= oz - ohz && pz <= oz + ohz
            return true
        endif
    endfor
    return false
end

define create_road_curb_vbo(instances)
    num_instances = instances.len / 9
    on num_instances == 0 do return pack_vbo_pair(0, 0)
    curb_instances = []
    curb_width = 0.25
    curb_height = 0.08
    segment_len = 1.0
    for inst = 0 to num_instances - 1
        base = inst * 9
        ix = instances[base]
        iy = instances[base + 1] + inst * 0.0002
        iz = instances[base + 2]
        sx = instances[base + 3]
        sz = instances[base + 5]
        hx = sx * 0.5
        hz = sz * 0.5
        # Dark grey curb
        cr = 0.3; cg = 0.3; cb = 0.3
        if sx >= sz
            # X-aligned road: width is along Z, curbs run along X.
            z_edges = [iz - hz, iz + hz]
            for edge_idx = 0 to z_edges.len - 1
                edge_z = z_edges[edge_idx]
                num_segs = as_int((sx + segment_len - 0.001) / segment_len)
                if num_segs < 1
                    num_segs = 1
                endif
                for s = 0 to num_segs - 1
                    seg_start = ix - hx + s * segment_len
                    seg_end = seg_start + segment_len
                    if seg_end > ix + hx
                        seg_end = ix + hx
                    endif
                    seg_len = seg_end - seg_start
                    continue if seg_len < 0.001
                    seg_center_x = seg_start + seg_len * 0.5
                    # Offset the test point slightly outward so we keep curbs right
                    # up to the edge of a crossing road without dipping inside it.
                    test_z = edge_z + (edge_z - iz) * 0.1
                    if !point_inside_any_road(seg_center_x, test_z, instances, inst)
                        curb_instances = concat(curb_instances, [seg_center_x, iy + curb_height * 0.5, edge_z, seg_len, curb_height, curb_width, cr, cg, cb])
                    endif
                endfor
            endfor
        else
            # Z-aligned road: width is along X, curbs run along Z.
            x_edges = [ix - hx, ix + hx]
            for edge_idx = 0 to x_edges.len - 1
                edge_x = x_edges[edge_idx]
                num_segs = as_int((sz + segment_len - 0.001) / segment_len)
                if num_segs < 1
                    num_segs = 1
                endif
                for s = 0 to num_segs - 1
                    seg_start = iz - hz + s * segment_len
                    seg_end = seg_start + segment_len
                    if seg_end > iz + hz
                        seg_end = iz + hz
                    endif
                    seg_len = seg_end - seg_start
                    continue if seg_len < 0.001
                    seg_center_z = seg_start + seg_len * 0.5
                    test_x = edge_x + (edge_x - ix) * 0.1
                    if !point_inside_any_road(test_x, seg_center_z, instances, inst)
                        curb_instances = concat(curb_instances, [edge_x, iy + curb_height * 0.5, seg_center_z, curb_width, curb_height, seg_len, cr, cg, cb])
                    endif
                endfor
            endfor
        endif
    endfor
    road_curb_segment_count = curb_instances.len / 9
    return create_merged_box_vbo(curb_instances)
end

define create_terrain_vbo()
    grid_min = -WORLD_HALF
    grid_max = WORLD_HALF
    grid_step = 2.0

    # Count total vertices
    grid_count = (grid_max - grid_min) / grid_step + 1.0
    total_vertices = grid_count * 4  # 4 vertices per grid cell × grid_count
    num_floats = as_int(total_vertices) * 3

    # Allocate memory for vertices
    verts_ptr = c_alloc(num_floats * 4)
    vert_idx = 0

    # Z-parallel lines (constant X, varying Z)
    for z_idx = grid_min to grid_max step grid_step
        # Line from (grid_min, 0, z) to (grid_max, 0, z)
        c_set_float(verts_ptr, (vert_idx )*4, grid_min)
        c_set_float(verts_ptr, (vert_idx + 1)*4, 0.0)
        c_set_float(verts_ptr, (vert_idx + 2)*4, z_idx.as_float)
        vert_idx = vert_idx + 3

        c_set_float(verts_ptr, (vert_idx )*4, grid_max)
        c_set_float(verts_ptr, (vert_idx + 1)*4, 0.0)
        c_set_float(verts_ptr, (vert_idx + 2)*4, z_idx.as_float)
        vert_idx = vert_idx + 3
    endfor

    # X-parallel lines (varying X, constant Z)
    for x_idx = grid_min to grid_max step grid_step
        # Line from (x, 0, grid_min) to (x, 0, grid_max)
        c_set_float(verts_ptr, (vert_idx )*4, x_idx.as_float)
        c_set_float(verts_ptr, (vert_idx + 1)*4, 0.0)
        c_set_float(verts_ptr, (vert_idx + 2)*4, grid_min)
        vert_idx = vert_idx + 3

        c_set_float(verts_ptr, (vert_idx )*4, x_idx.as_float)
        c_set_float(verts_ptr, (vert_idx + 1)*4, 0.0)
        c_set_float(verts_ptr, (vert_idx + 2)*4, grid_max)
        vert_idx = vert_idx + 3
    endfor

    vbo = upload_vbo(verts_ptr, num_floats * 4)

    # Allocate memory for colors (all gray)
    colors_ptr = c_alloc(num_floats * 4)
    for i = 0 to as_int(total_vertices) - 1
        c_set_float(colors_ptr, (i*3 )*4, 0.5)
        c_set_float(colors_ptr, (i*3 + 1)*4, 0.5)
        c_set_float(colors_ptr, (i*3 + 2)*4, 0.5)
    endfor

    color_vbo = upload_vbo(colors_ptr, num_floats * 4)
    return pack_vbo_pair(vbo, color_vbo)
end

# Generate a ragged-edge grass floor grid with jittered boundary vertices.
# Uses 8x8 subdivision to hide the hard world boundary.
define create_textured_floor_vbo()
    # 9x9 grid of vertices -> 8x8 quads covering -WORLD_HALF to +WORLD_HALF in X and Z, at y=0.0
    # Boundary vertices are jittered for a ragged natural edge.
    # Each vertex: position (3) + normal (3) + UV (2) = 8 floats
    s = WORLD_HALF
    grids = 8
    cell = s * 2.0 / grids
    y = 0.0
    uv_repeat = 12.0
    stride = 8
    nx = 0.0
    ny = 1.0
    nz = 0.0

    # Precompute jittered vertex positions in a 2D grid
    vx = []
    vz = []

    for j = 0 to grids
        zbase = -s + j * cell
        for i = 0 to grids
            xbase = -s + i * cell
            # Jitter outer edge vertices only
            jx = 0.0
            jz = 0.0
            if i == 0
                jx = sin(zbase * 0.7 + 1.3) * 1.8 + cos(zbase * 1.1 + 3.1) * 0.7
            endif
            if i == grids
                jx = sin(zbase * 0.7 + 2.1) * 1.8 + cos(zbase * 1.1 + 0.5) * 0.7
            endif
            if j == 0
                jz = sin(xbase * 0.7 + 4.2) * 1.8 + cos(xbase * 1.1 + 2.7) * 0.7
            endif
            if j == grids
                jz = sin(xbase * 0.7 + 0.9) * 1.8 + cos(xbase * 1.1 + 5.3) * 0.7
            endif
            # Clamp so grass only extends into the beach, never retreats into town/roads
            on i == 0  && jx > 0.0 do jx = 0.0
            on i == grids && jx < 0.0 do jx = 0.0
            on j == 0  && jz > 0.0 do jz = 0.0
            on j == grids && jz < 0.0 do jz = 0.0
            vx = concat(vx, [xbase + jx])
            vz = concat(vz, [zbase + jz])
        endfor
    endfor

    num_quads = grids * grids
    verts_ptr = c_alloc(num_quads * 4 * stride * 4)
    idx = 0

    for j = 0 to grids - 1
        for i = 0 to grids - 1
            # Vertex indices in the (grids+1) x (grids+1) grid
            v00 = j * (grids + 1) + i
            v10 = j * (grids + 1) + (i + 1)
            v11 = (j + 1) * (grids + 1) + (i + 1)
            v01 = (j + 1) * (grids + 1) + i

            # Quad corners in CCW order when viewed from above (+Y): v00, v01, v11, v10
            # UVs span the full texture repeat across the whole floor
            fi = as_float(i)
            fj = as_float(j)
            fg = as_float(grids)
            corners = [v00, v01, v11, v10]
            u_low  = (fi / fg) * uv_repeat
            u_high = ((fi + 1.0) / fg) * uv_repeat
            v_low  = (fj / fg) * uv_repeat
            v_high = ((fj + 1.0) / fg) * uv_repeat
            uvs = [
                [u_low,  v_low],
                [u_low,  v_high],
                [u_high, v_high],
                [u_high, v_low]
            ]

            for c = 0 to 3
                vi = corners[c]
                base = idx * stride * 4
                c_set_float(verts_ptr, base + 0*4, vx[vi])
                c_set_float(verts_ptr, base + 1*4, y)
                c_set_float(verts_ptr, base + 2*4, vz[vi])
                c_set_float(verts_ptr, base + 3*4, nx)
                c_set_float(verts_ptr, base + 4*4, ny)
                c_set_float(verts_ptr, base + 5*4, nz)
                c_set_float(verts_ptr, base + 6*4, uvs[c][0])
                c_set_float(verts_ptr, base + 7*4, uvs[c][1])
                idx = idx + 1
            endfor
        endfor
    endfor

    vbo = upload_vbo(verts_ptr, num_quads * 4 * stride * 4)
    return pack_vbo_pair(vbo, num_quads * 4)
end

define draw_grass_floor_vbo(vbo_data, texture_id)
    vbo = vbo_data[0]
    num_verts = vbo_data[1]

    glEnable(GL_TEXTURE_2D)
    glBindTexture(GL_TEXTURE_2D, texture_id)
    glTexEnvi(GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_MODULATE)

    # Keep the ground plane crisp and green: it is not faded by distance fog.
    glDisable(GL_FOG)

    glEnableClientState(GL_VERTEX_ARRAY)
    glEnableClientState(GL_NORMAL_ARRAY)
    glEnableClientState(GL_TEXTURE_COORD_ARRAY)

    glBindBuffer(GL_ARRAY_BUFFER, vbo)
    # Position: 3 floats, stride = 8*4 = 32 bytes, offset = 0
    glVertexPointer(3, GL_FLOAT, 32, 0)
    # Normal: 3 floats, stride = 32 bytes, offset = 12 bytes
    glNormalPointer(GL_FLOAT, 32, 12)
    # Texcoord: 2 floats, stride = 32 bytes, offset = 24 bytes
    glTexCoordPointer(2, GL_FLOAT, 32, 24)

    glColor3f(1.3, 1.3, 1.1)
    glDrawArrays(GL_QUADS, 0, num_verts)

    glDisableClientState(GL_VERTEX_ARRAY)
    glDisableClientState(GL_NORMAL_ARRAY)
    glDisableClientState(GL_TEXTURE_COORD_ARRAY)

    glEnable(GL_FOG)

    glBindTexture(GL_TEXTURE_2D, 0)
    glDisable(GL_TEXTURE_2D)
end

define draw_terrain_vao(vao_id)
    glDisable(GL_CULL_FACE)

    # Bind VAO (all state is already configured)
    glBindVertexArray(vao_id)

    # Draw all grid lines (81 per axis -> 162 lines -> 324 vertices)
    grid_lines = as_int((WORLD_HALF - (-WORLD_HALF)) / 2.0 + 1.0)
    glDrawArrays(GL_LINES, 0, grid_lines * 4)

    # Unbind VAO
    glBindVertexArray(0)

    glEnable(GL_CULL_FACE)
end

define create_cube_vao(vbo_data)
    vbo = vbo_data[0]
    color_vbo = vbo_data[1]

    # Create VAO
    vao = gl_gen_vao()

    # Bind VAO (all subsequent state changes are cached)
    glBindVertexArray(vao)

    # Enable and bind vertex array
    glEnableClientState(GL_VERTEX_ARRAY)
    glBindBuffer(GL_ARRAY_BUFFER, vbo)
    glVertexPointer(3, GL_FLOAT, 0, 0)

    # Enable and bind color array
    glEnableClientState(GL_COLOR_ARRAY)
    glBindBuffer(GL_ARRAY_BUFFER, color_vbo)
    glColorPointer(3, GL_FLOAT, 0, 0)

    # Unbind VAO
    glBindVertexArray(0)
    glBindBuffer(GL_ARRAY_BUFFER, 0)
    return vao
end

