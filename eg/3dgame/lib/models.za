doc "
lib/models.za — OBJ/MTL parsing and VBO factory
-----------------------------------------------

Converts Wavefront OBJ + MTL files into OpenGL VBOs. Demonstrates
za string manipulation and C memory buffer patterns.
"

namespace main

# Parse Wavefront OBJ text into vertex/texcoord/normal/index arrays.
# Handles v, vt, vn, f, usemtl, newmtl. Groups triangles by material.
define parse_obj(text)
    verts = []      # flat: [x1,y1,z1, x2,y2,z2, ...]
    texcoords = []  # flat: [u1,v1, u2,v2, ...]
    vert_indices = []  # flat triangle vertex indices
    tex_indices = []   # flat triangle texcoord indices
    vertex_colors = [] # flat: [r1,g1,b1, r2,g2,b2, ...] (empty if no vertex colors)
    material_groups = [] # flat: [start_tri, count, name_idx, start_tri, count, name_idx, ...]
    material_names = []  # list of material name strings
    current_mtl_idx = 0  # default material index (0 = no material)
    current_mtl_name = ""
    has_mtl = false
    has_vertex_colors = false
    has_vn = false
    normals = []
    norm_indices = []
    lines = split(text, "\n")
    tri_count = 0
    for i = 0 to lines.len - 1
        line = lines[i]
        continue if line.len == 0
        # Strip trailing carriage returns from Windows CRLF files
        while line.len > 0 && line[line.len - 1] == "\r"
            line = line[0:line.len-1]
        endwhile
        continue if line.len == 0
        # mtllib reference (e.g., "mtllib tree.mtl")
        if line.len >= 6
            if line[0] == "m" && line[1] == "t" && line[2] == "l" && line[3] == "l" && line[4] == "i" && line[5] == "b"
                parts = split(line, " ")
                if parts.len >= 2
                    has_mtl = true
                endif
                continue
            endif
        endif
        # usemtl directive (e.g., "usemtl Bark")
        if line.len >= 6
            if line[0] == "u" && line[1] == "s" && line[2] == "e" && line[3] == "m" && line[4] == "t" && line[5] == "l"
                parts = split(line, " ")
                if parts.len >= 2
                    mtl_name = parts[1]
                    # Find or add material name
                    found = false
                    new_idx = 0
                    for mi = 0 to material_names.len - 1
                        if material_names[mi] == mtl_name
                            new_idx = mi
                            found = true
                            break
                        endif
                    endfor
                    if !found
                        new_idx = material_names.len
                        material_names = concat(material_names, [mtl_name])
                    endif
                    # Close previous material group if it has triangles
                    if current_mtl_name != "" && tri_count > 0
                        material_groups = concat(material_groups, [tri_count, current_mtl_idx])
                    endif
                    current_mtl_idx = new_idx
                    current_mtl_name = mtl_name
                    tri_count = 0
                endif
                continue
            endif
        endif
        # Vertex: "v x y z" or "v x y z r g b"
        if line[0] == "v" && line[1] == " "
            parts = split(line, " ")
            vals = []
            for j = 1 to parts.len - 1
                if parts[j].len > 0
                    vals = concat(vals, [parts[j].as_float])
                endif
            endfor
            if vals.len >= 3
                verts = concat(verts, [vals[0], vals[1], vals[2]])
                if vals.len >= 6
                    vertex_colors = concat(vertex_colors, [vals[3], vals[4], vals[5]])
                    has_vertex_colors = true
                else
                    vertex_colors = concat(vertex_colors, [1.0, 1.0, 1.0])
                endif
            endif
            continue
        endif
        # Texture coordinate: "vt u v"
        if line[0] == "v" && line[1] == "t" && line[2] == " "
            parts = split(line, " ")
            vals = []
            for j = 1 to parts.len - 1
                if parts[j].len > 0
                    vals = concat(vals, [parts[j].as_float])
                endif
            endfor
            if vals.len >= 2
                # Flip V coordinate for OpenGL (OBJ v=0 is top, OpenGL v=0 is bottom)
                texcoords = concat(texcoords, [vals[0], 1.0 - vals[1]])
            endif
            continue
        endif
        # Normal: "vn x y z"
        if line[0] == "v" && line[1] == "n" && line[2] == " "
            parts = split(line, " ")
            nvals = []
            for j = 1 to parts.len - 1
                if parts[j].len > 0
                    nvals = concat(nvals, [parts[j].as_float])
                endif
            endfor
            if nvals.len >= 3
                normals = concat(normals, [nvals[0], nvals[1], nvals[2]])
                has_vn = true
            endif
            continue
        endif
        # Face: "f v/vt/vn v/vt/vn v/vt/vn" or "f v//vn v//vn v//vn"
        if line[0] == "f" && line[1] == " "
            parts = split(line, " ")
            face_verts = []
            face_texs = []
            face_norms = []
            for j = 1 to parts.len - 1
                if parts[j].len > 0
                    slash_parts = split(parts[j], "/")
                    vidx = slash_parts[0].as_int - 1
                    face_verts = concat(face_verts, [vidx])
                    if slash_parts.len >= 2 && slash_parts[1].len > 0
                        tidx = slash_parts[1].as_int - 1
                        face_texs = concat(face_texs, [tidx])
                    else
                        face_texs = concat(face_texs, [0])
                    endif
                    if slash_parts.len >= 3 && slash_parts[2].len > 0
                        nidx = slash_parts[2].as_int - 1
                        face_norms = concat(face_norms, [nidx])
                    else
                        face_norms = concat(face_norms, [0])
                    endif
                endif
            endfor
            if face_verts.len >= 3
                # Fan triangulation for quads and n-gons
                for j = 1 to face_verts.len - 2
                    vert_indices = concat(vert_indices, [face_verts[0], face_verts[j], face_verts[j+1]])
                    tex_indices = concat(tex_indices, [face_texs[0], face_texs[j], face_texs[j+1]])
                    norm_indices = concat(norm_indices, [face_norms[0], face_norms[j], face_norms[j+1]])
                    tri_count++
                endfor
            endif
        endif
    endfor
    # Close final material group
    if current_mtl_name != "" && tri_count > 0
        material_groups = concat(material_groups, [tri_count, current_mtl_idx])
    endif
    # If no texcoords were found, add a single default (0,0) so indices don't go out of bounds
    on texcoords.len == 0 do texcoords = [0.0, 0.0]
    # If no normals found, add a default upward normal so arrays don't go out of bounds
    on normals.len == 0 do normals = [0.0, 1.0, 0.0]
    # If no vertex colors found, ensure array matches verts length
    if !has_vertex_colors
        vertex_colors = []
        for vi = 0 to verts.len / 3 - 1
            vertex_colors = concat(vertex_colors, [1.0, 1.0, 1.0])
        endfor
    endif
    if !has_mtl
        material_names = []
    endif
    return verts, texcoords, vert_indices, tex_indices, vertex_colors, material_groups, material_names, normals, norm_indices
end

define create_textured_obj_vbo(verts, texcoords, normals, vert_indices, tex_indices, norm_indices)
    num_tris = vert_indices.len / 3
    num_verts = num_tris * 3

    pos_ptr = c_alloc(num_verts * 3 * 4)
    tex_ptr = c_alloc(num_verts * 2 * 4)
    norm_ptr = c_alloc(num_verts * 3 * 4)

    for i = 0 to num_tris - 1
        for j = 0 to 2
            v_idx = vert_indices[i * 3 + j]
            t_idx = tex_indices[i * 3 + j]
            n_idx = norm_indices[i * 3 + j]
            off = i * 3 + j
            c_set_float(pos_ptr, off * 3 * 4, verts[v_idx * 3])
            c_set_float(pos_ptr, (off * 3 + 1) * 4, verts[v_idx * 3 + 1])
            c_set_float(pos_ptr, (off * 3 + 2) * 4, verts[v_idx * 3 + 2])
            c_set_float(tex_ptr, off * 2 * 4, texcoords[t_idx * 2])
            c_set_float(tex_ptr, (off * 2 + 1) * 4, texcoords[t_idx * 2 + 1])
            c_set_float(norm_ptr, off * 3 * 4, normals[n_idx * 3])
            c_set_float(norm_ptr, (off * 3 + 1) * 4, normals[n_idx * 3 + 1])
            c_set_float(norm_ptr, (off * 3 + 2) * 4, normals[n_idx * 3 + 2])
        endfor
    endfor

    vbo = upload_vbo(pos_ptr, num_verts * 3 * 4)
    tex_vbo = upload_vbo(tex_ptr, num_verts * 2 * 4)
    norm_vbo = upload_vbo(norm_ptr, num_verts * 3 * 4)
    return pack_vbo_quad(vbo, tex_vbo, norm_vbo, num_verts)
end

define draw_textured_obj_vbo(vbo_data, texture_id)
    vbo = vbo_data[0]
    tex_vbo = vbo_data[1]
    norm_vbo = vbo_data[2]
    num_verts = vbo_data[3]

    on texture_id > 0 do glEnable(GL_TEXTURE_2D); glBindTexture(GL_TEXTURE_2D, texture_id); glTexEnvi(GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_MODULATE)

    glEnableClientState(GL_VERTEX_ARRAY)
    glEnableClientState(GL_TEXTURE_COORD_ARRAY)
    glEnableClientState(GL_NORMAL_ARRAY)

    glBindBuffer(GL_ARRAY_BUFFER, vbo)
    glVertexPointer(3, GL_FLOAT, 0, 0)

    glBindBuffer(GL_ARRAY_BUFFER, tex_vbo)
    glTexCoordPointer(2, GL_FLOAT, 0, 0)

    glBindBuffer(GL_ARRAY_BUFFER, norm_vbo)
    glNormalPointer(GL_FLOAT, 0, 0)

    glDrawArrays(GL_TRIANGLES, 0, num_verts)

    glDisableClientState(GL_VERTEX_ARRAY)
    glDisableClientState(GL_TEXTURE_COORD_ARRAY)
    glDisableClientState(GL_NORMAL_ARRAY)

    on texture_id > 0 do glBindTexture(GL_TEXTURE_2D, 0); glDisable(GL_TEXTURE_2D)

    glBindBuffer(GL_ARRAY_BUFFER, 0)
end

define compute_flat_normals(verts, vert_indices)
    normals = []
    norm_indices = []
    num_tris = vert_indices.len / 3
    for i = 0 to num_tris - 1
        i0 = vert_indices[i * 3]
        i1 = vert_indices[i * 3 + 1]
        i2 = vert_indices[i * 3 + 2]
        ax = verts[i1 * 3] - verts[i0 * 3]
        ay = verts[i1 * 3 + 1] - verts[i0 * 3 + 1]
        az = verts[i1 * 3 + 2] - verts[i0 * 3 + 2]
        bx = verts[i2 * 3] - verts[i0 * 3]
        by = verts[i2 * 3 + 1] - verts[i0 * 3 + 1]
        bz = verts[i2 * 3 + 2] - verts[i0 * 3 + 2]
        nx = ay * bz - az * by
        ny = az * bx - ax * bz
        nz = ax * by - ay * bx
        len = sqrt(nx * nx + ny * ny + nz * nz)
        on len > 0.0 do nx = nx / len; ny = ny / len; nz = nz / len
        normals = concat(normals, [nx, ny, nz])
        norm_indices = concat(norm_indices, [i, i, i])
    endfor
    return normals, norm_indices
end

define draw_obj_vbo(vbo_data)
    vbo = vbo_data[0]
    color_vbo = vbo_data[1]
    num_verts = vbo_data[2]

    glEnableClientState(GL_VERTEX_ARRAY)
    glEnableClientState(GL_COLOR_ARRAY)
    glBindBuffer(GL_ARRAY_BUFFER, vbo)
    glVertexPointer(3, GL_FLOAT, 0, 0)
    glBindBuffer(GL_ARRAY_BUFFER, color_vbo)
    glColorPointer(3, GL_FLOAT, 0, 0)
    glDrawArrays(GL_TRIANGLES, 0, num_verts)
    glDisableClientState(GL_VERTEX_ARRAY)
    glDisableClientState(GL_COLOR_ARRAY)
    glBindBuffer(GL_ARRAY_BUFFER, 0)
end

define create_colored_obj_vbo(verts, vertex_colors, vert_indices)
    num_tris = vert_indices.len / 3
    num_verts = num_tris * 3

    pos_ptr = c_alloc(num_verts * 3 * 4)
    col_ptr = c_alloc(num_verts * 3 * 4)

    for i = 0 to num_tris - 1
        for j = 0 to 2
            v_idx = vert_indices[i * 3 + j]
            off = (i * 3 + j)
            c_set_float(pos_ptr, off * 3 * 4, verts[v_idx * 3 + 0])
            c_set_float(pos_ptr, (off * 3 + 1) * 4, verts[v_idx * 3 + 1])
            c_set_float(pos_ptr, (off * 3 + 2) * 4, verts[v_idx * 3 + 2])
            c_set_float(col_ptr, off * 3 * 4, vertex_colors[v_idx * 3 + 0])
            c_set_float(col_ptr, (off * 3 + 1) * 4, vertex_colors[v_idx * 3 + 1])
            c_set_float(col_ptr, (off * 3 + 2) * 4, vertex_colors[v_idx * 3 + 2])
        endfor
    endfor

    vbo_ptr = c_alloc(4)
    glGenBuffers(1, vbo_ptr)
    vbo = c_get_int32(vbo_ptr, 0)
    c_free(vbo_ptr)
    glBindBuffer(GL_ARRAY_BUFFER, vbo)
    glBufferData(GL_ARRAY_BUFFER, num_verts * 3 * 4, pos_ptr, GL_STATIC_DRAW)
    c_free(pos_ptr)

    col_vbo_ptr = c_alloc(4)
    glGenBuffers(1, col_vbo_ptr)
    color_vbo = c_get_int32(col_vbo_ptr, 0)
    c_free(col_vbo_ptr)
    glBindBuffer(GL_ARRAY_BUFFER, color_vbo)
    glBufferData(GL_ARRAY_BUFFER, num_verts * 3 * 4, col_ptr, GL_STATIC_DRAW)
    c_free(col_ptr)
    glBindBuffer(GL_ARRAY_BUFFER, 0)

    result = c_alloc(12)
    c_set_int32(result, 0, vbo)
    c_set_int32(result, 4, color_vbo)
    c_set_int32(result, 8, num_verts)
    return result
end

define create_colored_obj_vbos_by_material(verts, vert_indices, material_groups, material_names, mtl_kd)
    results = []
    if material_groups.len == 0
        # No materials, create single VBO with white color
        vertex_colors = []
        for vi = 0 to verts.len / 3 - 1
            vertex_colors = concat(vertex_colors, [1.0, 1.0, 1.0])
        endfor
        vbo_data = create_colored_obj_vbo(verts, vertex_colors, vert_indices)
        results = concat(results, [c_get_int32(vbo_data, 0), c_get_int32(vbo_data, 4), c_get_int32(vbo_data, 8)])
        return results
    endif
    tri_offset = 0
    for mg = 0 to material_groups.len - 1 step 2
        tri_count = material_groups[mg]
        mtl_idx = material_groups[mg + 1]
        # Extract triangles for this material group
        sub_vert_indices = []
        for t = 0 to tri_count - 1
            global_tri = tri_offset + t
            sub_vert_indices = concat(sub_vert_indices, [
                vert_indices[global_tri * 3 + 0],
                vert_indices[global_tri * 3 + 1],
                vert_indices[global_tri * 3 + 2]
            ])
        endfor
        # Get Kd color for this material
        cr = 0.8; cg = 0.8; cb = 0.8
        if mtl_idx < material_names.len
            cr = mtl_kd[mtl_idx * 3 + 0]
            cg = mtl_kd[mtl_idx * 3 + 1]
            cb = mtl_kd[mtl_idx * 3 + 2]
        endif

        # Create vertex colors array (all vertices get Kd color)
        vertex_colors = []
        for vi = 0 to verts.len / 3 - 1
            vertex_colors = concat(vertex_colors, [cr, cg, cb])
        endfor
        vbo_data = create_colored_obj_vbo(verts, vertex_colors, sub_vert_indices)
        results = concat(results, [c_get_int32(vbo_data, 0), c_get_int32(vbo_data, 4), c_get_int32(vbo_data, 8)])
        tri_offset = tri_offset + tri_count
    endfor
    return results
end

define draw_colored_model_groups(model_groups, x, y, z, sx, sy, sz, yaw, cr, cg, cb)
    on model_groups.len == 0 do return
    glPushMatrix()
    glTranslatef(x, y, z)
    on yaw != 0.0 do glRotatef(yaw * 57.29578, 0.0, 1.0, 0.0)
    glScalef(sx, sy, sz)
    glColor3f(cr, cg, cb)
    # Vertex-colored props use their own MTL colors, not scene textures/lighting
    glDisable(GL_TEXTURE_2D)
    glDisable(GL_LIGHTING)
    for mg = 0 to model_groups.len - 1 step 3
        vbo = model_groups[mg]
        color_vbo = model_groups[mg + 1]
        num_verts = model_groups[mg + 2]
        glEnableClientState(GL_VERTEX_ARRAY)
        glEnableClientState(GL_COLOR_ARRAY)
        glBindBuffer(GL_ARRAY_BUFFER, vbo)
        glVertexPointer(3, GL_FLOAT, 0, 0)
        glBindBuffer(GL_ARRAY_BUFFER, color_vbo)
        glColorPointer(3, GL_FLOAT, 0, 0)
        glDrawArrays(GL_TRIANGLES, 0, num_verts)
        glDisableClientState(GL_VERTEX_ARRAY)
        glDisableClientState(GL_COLOR_ARRAY)
        glBindBuffer(GL_ARRAY_BUFFER, 0)
    endfor
    glEnable(GL_LIGHTING)
    glEnable(GL_TEXTURE_2D)
    glPopMatrix()
end

# Parse an MTL file for material names, diffuse colors (Kd), and texture paths.
define load_mtl(path)
    material_names = []
    material_kd = []
    material_textures = []
    current_name = ""
    current_kd = [0.8, 0.8, 0.8]
    current_tex = ""
    text = read_file(path)
    on text == "" do return material_names, material_kd, material_textures
    lines = split(text, "\n")
    for i = 0 to lines.len - 1
        line = lines[i]
        continue if line.len == 0
        # newmtl name
        if line[0] == "n" && line[1] == "e" && line[2] == "w" && line[3] == "m" && line[4] == "t" && line[5] == "l"
            # Save previous material
            if current_name != ""
                material_names = concat(material_names, [current_name])
                material_kd = concat(material_kd, current_kd)
                material_textures = concat(material_textures, [current_tex])
            endif
            parts = split(line, " ")
            if parts.len >= 2
                current_name = parts[1]
            else
                current_name = "default"
            endif
            current_kd = [0.8, 0.8, 0.8]
            current_tex = ""
            continue
        endif
        # Kd r g b (diffuse color)
        if line[0] == "K" && line[1] == "d"
            parts = split(line, " ")
            if parts.len >= 4
                current_kd = [parts[1].as_float, parts[2].as_float, parts[3].as_float]
            endif
            continue
        endif
        # map_Kd texture_path
        if line[0] == "m" && line[1] == "a" && line[2] == "p" && line[3] == "_" && line[4] == "K" && line[5] == "d"
            parts = split(line, " ")
            if parts.len >= 2
                current_tex = parts[1]
            endif
            continue
        endif
    endfor
    # Save last material
    if current_name != ""
        material_names = concat(material_names, [current_name])
        material_kd = concat(material_kd, current_kd)
        material_textures = concat(material_textures, [current_tex])
    endif
    return material_names, material_kd, material_textures
end

# Compute axis-aligned bounding box from vertex data for collision sizing.
define measure_obj_bounds(verts)
    if verts.len < 3
        return 0.5, 0.5, 0.5
    endif
    min_x = verts[0]; max_x = verts[0]
    min_y = verts[1]; max_y = verts[1]
    min_z = verts[2]; max_z = verts[2]
    for i = 0 to verts.len - 1 step 3
        x = verts[i]; y = verts[i+1]; z = verts[i+2]
        if x < min_x
            min_x = x
        endif
        if x > max_x
            max_x = x
        endif
        if y < min_y
            min_y = y
        endif
        if y > max_y
            max_y = y
        endif
        if z < min_z
            min_z = z
        endif
        if z > max_z
            max_z = z
        endif
    endfor
    return (max_x - min_x) * 0.5, (max_y - min_y) * 0.5, (max_z - min_z) * 0.5
end

# Split an OBJ into per-material VBOs with interleaved position+UV+normal.
# Returns a flat array: [vbo, tex_vbo, norm_vbo, num_verts, tex_id, ...].
define create_textured_obj_vbos_by_material(verts, texcoords, normals, vert_indices, tex_indices, norm_indices, material_groups, material_names, tex_base_path, mtl_kd, mtl_textures)
    results = []
    if material_groups.len == 0
        # No materials, create single VBO with all geometry
        vbo_data = create_textured_obj_vbo(verts, texcoords, normals, vert_indices, tex_indices, norm_indices)
        results = concat(results, concat(vbo_data, [0]))
        return results
    endif
    # material_groups is flat: [tri_count, mtl_idx, tri_count, mtl_idx, ...]
    tri_offset = 0
    for mg = 0 to material_groups.len - 1 step 2
        tri_count = material_groups[mg]
        mtl_idx = material_groups[mg + 1]
        sub_vert_indices, sub_tex_indices = extract_sub_tris(vert_indices, tex_indices, tri_offset, tri_count)
        sub_norm_indices = []
        for t = 0 to tri_count - 1
            gt = tri_offset + t
            sub_norm_indices = concat(sub_norm_indices, [norm_indices[gt*3], norm_indices[gt*3+1], norm_indices[gt*3+2]])
        endfor
        # Create VBO for this group
        vbo_data = create_textured_obj_vbo(verts, texcoords, normals, sub_vert_indices, sub_tex_indices, sub_norm_indices)
        # Load texture for this material
        tex_id = 0
        if mtl_idx < mtl_textures.len && mtl_textures[mtl_idx] != ""
            tex_path = tex_base_path + mtl_textures[mtl_idx]
            tex_id = load_png_texture(tex_path)
        endif
        results = concat(results, concat(vbo_data, [tex_id]))
        tri_offset = tri_offset + tri_count
    endfor
    return results
end

define draw_textured_model_groups(model_groups, x, y, z, sx, sy, sz, yaw, cr, cg, cb)
    on model_groups.len == 0 do return
    glPushMatrix()
    glTranslatef(x, y, z)
    on yaw != 0.0 do glRotatef(yaw * 57.29578, 0.0, 1.0, 0.0)
    glScalef(sx, sy, sz)
    glColor3f(cr, cg, cb)
    for mg = 0 to model_groups.len - 1 step 5
        draw_raw_textured_group(model_groups[mg], model_groups[mg + 1], model_groups[mg + 2], model_groups[mg + 3], model_groups[mg + 4])
    endfor
    glPopMatrix()
end

