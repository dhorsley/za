# Interactive object proximity detection, Z key handling, and message timer
define update_interactables(delta_time)
    nearest_interactable = -1
    nearest_dist = 9999.0
    for i = 0 to interactables.len - 1 step 5
        ix = interactables[i]
        iz = interactables[i + 1]
        ir = interactables[i + 2]
        dx = player_pos[0] - ix
        dz = player_pos[2] - iz
        dist = sqrt(dx * dx + dz * dz)
        if dist < ir && dist < nearest_dist
            nearest_dist = dist
            nearest_interactable = i
        endif
    endfor
    if nearest_interactable >= 0
        itype = interactables[nearest_interactable + 3]
        ilabel = interactables[nearest_interactable + 4]
        prompt_text = "Press Z to " + ilabel
        on itype == 2 do prompt_text = interactable_states[as_int(nearest_interactable / 5)] != 0 ? "Press Z to put out the bonfire" : "Press Z to light the bonfire"
        on prompt_panel[PANEL_TEXT] != prompt_text do update_panel_text(prompt_panel, prompt_text)
        @prompt_panel[PANEL_VISIBLE] = true
        pw = prompt_panel[PANEL_W]
        @prompt_panel[PANEL_X] = (actual_window_width - pw) * 0.5
        @prompt_panel[PANEL_Y] = legend_panel[PANEL_Y] + legend_panel[PANEL_H] + 10.0
    else
        @prompt_panel[PANEL_VISIBLE] = false
    endif

    # Handle Z key for interaction
    if glfwGetKey(window, GLFW_KEY_Z) != 0
        if nearest_interactable >= 0
            itype = interactables[nearest_interactable + 3]
            state_idx = as_int(nearest_interactable / 5)
            case itype
            is 0
                msg = "The water is cool and clear."
            is 1
                msg = "You draw a bucket of fresh water."
            is 2
                # Toggle bonfire lit/unlit state
                @interactable_states[state_idx] = 1 - interactable_states[state_idx]
                if interactable_states[state_idx] != 0
                    msg = "You light the bonfire."
                else
                    msg = "The fire goes out."
                endif
            is 3
                msg = "No one answers."
            is 4
                msg = "The stall is closed for the day."
            is 5
                msg = "The cart is empty."
            is 6
                msg = "The cauldron bubbles gently."
            or
                msg = "Nothing happens."
            endcase
            on message_panel[PANEL_TEXT] != msg do update_panel_text(message_panel, msg)
            @message_panel[PANEL_VISIBLE] = true
            @message_timer = 3.0
            mw = message_panel[PANEL_W]
            @message_panel[PANEL_X] = (actual_window_width - mw) * 0.5
            @message_panel[PANEL_Y] = prompt_panel[PANEL_Y] + prompt_panel[PANEL_H] + 10.0
        endif
    endif

    # Count down message timer
    if message_timer > 0
        @message_timer = message_timer - delta_time
        if message_timer <= 0
            @message_panel[PANEL_VISIBLE] = false
            @message_timer = 0.0
        endif
    endif
end

# Player movement: sprint, free-cam or normal movement, physics, jump
define update_player_movement(delta_time)
    @is_sprinting = glfwGetKey(window, GLFW_KEY_LEFT_SHIFT) != 0 || glfwGetKey(window, GLFW_KEY_RIGHT_SHIFT) != 0
    move_speed = CAMERA_SPEED
    if is_sprinting
        move_speed = CAMERA_SPEED * SPRINT_MULTIPLIER
        @anim_playback_speed = 1.8
    else
        @anim_playback_speed = 1.0
    endif
    # Apply shallow-water slowdown
    move_speed = move_speed * get_water_slowdown(player_pos[0], player_pos[2])

    @player_is_moving = false

    if free_camera
        cam_move_speed = free_cam_speed
        if is_sprinting
            cam_move_speed = free_cam_speed * 3.0
        endif
        if glfwGetKey(window, GLFW_KEY_W) != 0
            @free_cam_pos[0] = free_cam_pos[0] - sin(free_cam_yaw) * cam_move_speed * delta_time
            @free_cam_pos[2] = free_cam_pos[2] - cos(free_cam_yaw) * cam_move_speed * delta_time
        endif
        if glfwGetKey(window, GLFW_KEY_S) != 0
            @free_cam_pos[0] = free_cam_pos[0] + sin(free_cam_yaw) * cam_move_speed * delta_time
            @free_cam_pos[2] = free_cam_pos[2] + cos(free_cam_yaw) * cam_move_speed * delta_time
        endif
        if glfwGetKey(window, GLFW_KEY_Q) != 0
            @free_cam_pos[0] = free_cam_pos[0] - cos(free_cam_yaw) * cam_move_speed * delta_time
            @free_cam_pos[2] = free_cam_pos[2] + sin(free_cam_yaw) * cam_move_speed * delta_time
        endif
        if glfwGetKey(window, GLFW_KEY_E) != 0
            @free_cam_pos[0] = free_cam_pos[0] + cos(free_cam_yaw) * cam_move_speed * delta_time
            @free_cam_pos[2] = free_cam_pos[2] - sin(free_cam_yaw) * cam_move_speed * delta_time
        endif
        if glfwGetKey(window, GLFW_KEY_A) != 0
            @free_cam_yaw = free_cam_yaw + CAMERA_ROTATE_SPEED * delta_time
        endif
        if glfwGetKey(window, GLFW_KEY_D) != 0
            @free_cam_yaw = free_cam_yaw - CAMERA_ROTATE_SPEED * delta_time
        endif
        if glfwGetKey(window, GLFW_KEY_R) != 0
            @free_cam_pitch = free_cam_pitch + CAMERA_ROTATE_SPEED * delta_time
        endif
        if glfwGetKey(window, GLFW_KEY_F) != 0
            @free_cam_pitch = free_cam_pitch - CAMERA_ROTATE_SPEED * delta_time
        endif
        @free_cam_pitch = free_cam_pitch[-1.553343:1.553343]
        if glfwGetKey(window, GLFW_KEY_UP) != 0
            @free_cam_pos[1] = free_cam_pos[1] + cam_move_speed * delta_time
        endif
        if glfwGetKey(window, GLFW_KEY_DOWN) != 0
            @free_cam_pos[1] = free_cam_pos[1] - cam_move_speed * delta_time
        endif
        @free_cam_yaw = free_cam_yaw % 6.28318530718
        on free_cam_yaw < 0 do @free_cam_yaw = free_cam_yaw + 6.28318530718
    else
        if glfwGetKey(window, GLFW_KEY_W) != 0
            nx = player_pos[0] - sin(player_yaw) * move_speed * delta_time
            nz = player_pos[2] - cos(player_yaw) * move_speed * delta_time
            if !check_collision(nx, nz)
                @player_pos[0] = nx
                @player_pos[2] = nz
            endif
            @player_is_moving = true
        endif
        if glfwGetKey(window, GLFW_KEY_S) != 0
            nx = player_pos[0] + sin(player_yaw) * move_speed * delta_time
            nz = player_pos[2] + cos(player_yaw) * move_speed * delta_time
            if !check_collision(nx, nz)
                @player_pos[0] = nx
                @player_pos[2] = nz
            endif
            @player_is_moving = true
        endif
        if glfwGetKey(window, GLFW_KEY_Q) != 0
            nx = player_pos[0] - cos(player_yaw) * CAMERA_SPEED * delta_time
            nz = player_pos[2] + sin(player_yaw) * CAMERA_SPEED * delta_time
            if !check_collision(nx, nz)
                @player_pos[0] = nx
                @player_pos[2] = nz
            endif
            @player_is_moving = true
        endif
        if glfwGetKey(window, GLFW_KEY_E) != 0
            nx = player_pos[0] + cos(player_yaw) * CAMERA_SPEED * delta_time
            nz = player_pos[2] - sin(player_yaw) * CAMERA_SPEED * delta_time
            if !check_collision(nx, nz)
                @player_pos[0] = nx
                @player_pos[2] = nz
            endif
            @player_is_moving = true
        endif

        on glfwGetKey(window, GLFW_KEY_A) != 0 do @player_yaw = player_yaw + CAMERA_ROTATE_SPEED * delta_time
        on glfwGetKey(window, GLFW_KEY_D) != 0 do @player_yaw = player_yaw - CAMERA_ROTATE_SPEED * delta_time

        # Surface height under the player (road, doorstep, grass)
        ground_y = get_surface_height(player_pos[0], player_pos[2]) + player_feet_offset

        # Jump on Space (only when on the ground)
        space_now = glfwGetKey(window, GLFW_KEY_SPACE) != 0
        if space_now && !last_space_key && player_pos[1] <= ground_y + 0.05
            jump_vel = JUMP_VELOCITY
            if is_sprinting
                jump_vel = jump_vel * JUMP_RUN_HEIGHT_MULTIPLIER
            endif
            @player_vel_y = jump_vel
            if glfwGetKey(window, GLFW_KEY_W) != 0
                boost = JUMP_FORWARD_BOOST
                if is_sprinting
                    boost = boost * 2.0
                endif
                bx = player_pos[0] - sin(player_yaw) * boost
                bz = player_pos[2] - cos(player_yaw) * boost
                if !check_collision(bx, bz)
                    @player_pos[0] = bx
                    @player_pos[2] = bz
                endif
            endif
        endif
        @last_space_key = space_now

        @player_vel_y = player_vel_y - GRAVITY * delta_time
        @player_pos[1] = player_pos[1] + player_vel_y * delta_time
        if player_pos[1] <= ground_y
            @player_pos[1] = ground_y
            @player_vel_y = 0.0
        endif

        on glfwGetKey(window, GLFW_KEY_R) != 0 do @player_pitch = player_pitch + CAMERA_ROTATE_SPEED * delta_time
        on glfwGetKey(window, GLFW_KEY_F) != 0 do @player_pitch = player_pitch - CAMERA_ROTATE_SPEED * delta_time
    endif
end

