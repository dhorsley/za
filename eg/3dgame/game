INSTANCING_VS = "#version 330 compatibility\nlayout(location = 0) in vec3 aPos;\nlayout(location = 1) in vec2 aTexCoord;\nlayout(location = 2) in vec3 aNormal;\nlayout(location = 3) in vec3 aInstancePos;\nlayout(location = 4) in float aInstanceYaw;\nlayout(location = 5) in vec3 aInstanceScale;\nlayout(location = 6) in vec3 aInstanceColor;\nout vec2 vTexCoord;\nout vec4 vFrontColor;\nvoid main() {\n    float c = cos(aInstanceYaw);\n    float s = sin(aInstanceYaw);\n    mat3 rotY = mat3(c, 0.0, -s, 0.0, 1.0, 0.0, s, 0.0, c);\n    vec3 scaled = aPos * aInstanceScale;\n    vec3 world = rotY * scaled + aInstancePos;\n    gl_Position = gl_ModelViewProjectionMatrix * vec4(world, 1.0);\n    vTexCoord = aTexCoord;\n    vec3 N = normalize(mat3(gl_ModelViewMatrix) * (rotY * aNormal));\n    float NdotL = max(dot(N, normalize(gl_LightSource[0].position.xyz)), 0.0);\n    float NdotH = max(dot(N, normalize(gl_LightSource[0].halfVector.xyz)), 0.0);\n    vec4 lit = gl_FrontLightModelProduct.sceneColor\n             + gl_FrontLightProduct[0].ambient\n             + gl_FrontLightProduct[0].diffuse * NdotL\n             + gl_FrontLightProduct[0].specular * pow(NdotH, gl_FrontMaterial.shininess);\n    vFrontColor = clamp(vec4(aInstanceColor, 1.0) * lit, 0.0, 1.0);\n}\n"

INSTANCING_FS = "#version 330 compatibility\nin vec2 vTexCoord;\nin vec4 vFrontColor;\nuniform sampler2D uTexture;\nvoid main() {\n    vec4 tex = texture(uTexture, vTexCoord);\n    if (tex.a < 0.1) discard;\n    gl_FragColor = tex * vFrontColor;\n}\n"

# ---- Moat wave shader (GPU-animated, replaces CPU sin/cos per frame) ----
MOAT_VS = "#version 330 compatibility\nlayout(location=0) in vec3 aPos;\nlayout(location=1) in vec2 aTexCoord;\nlayout(location=2) in float aIsHoriz;\nlayout(location=3) in float aPushSign;\nout vec2 vTexCoord;\nout vec4 vColor;\nuniform float u_time;\nuniform float u_world_half;\nvoid main() {\n    float coord = aIsHoriz > 0.5 ? aPos.z : aPos.x;\n    float dist = abs(coord) - u_world_half;\n    dist = clamp(dist, 0.0, 10.0);\n    float taper = clamp(dist / 8.0 + 0.25, 0.0, 1.0);\n    float other = aIsHoriz > 0.5 ? aPos.x : aPos.z;\n    float phase = dist * 0.6 + other * 0.12 + u_time * 1.8;\n    float push = 0.15 * sin(phase) * taper;\n    float y_wave = 0.04 * sin(phase + 1.0) * taper;\n    float alpha = 0.35 + 0.45 * taper + 0.15 * sin(phase) * taper;\n    alpha = clamp(alpha, 0.2, 0.85);\n    vec3 world = aPos;\n    if (aIsHoriz > 0.5) { world.z = world.z + aPushSign * push; }\n    else { world.x = world.x + aPushSign * push; }\n    world.y = 0.02 + y_wave;\n    gl_Position = gl_ModelViewProjectionMatrix * vec4(world, 1.0);\n    vTexCoord = (gl_TextureMatrix[0] * vec4(aTexCoord, 0.0, 1.0)).xy;\n    vColor = vec4(0.5, 0.75, 0.85, alpha);\n}\n"

