        culling_enabled = !culling_enabled
        println format("Frustum culling: %v", culling_enabled)
        legend_panel[PANEL_NEEDS_UPDATE] = true
    endif

    triggered, last_t_key = toggle_pressed(window, GLFW_KEY_T, last_t_key)
    if triggered
        cursor_mode_normal = !cursor_mode_normal
        if cursor_mode_normal
            glfwSetInputMode(window, 0x00033001, 0x00034001)  # GLFW_CURSOR, GLFW_CURSOR_NORMAL
            println "Mouse mode ON — cursor visible, drag panels with left-click"
        else
            glfwSetInputMode(window, 0x00033001, 0x00034003)  # GLFW_CURSOR, GLFW_CURSOR_DISABLED
            println "Mouse mode OFF — mouse look active"
        endif
    endif

    triggered, last_tab = toggle_pressed(window, GLFW_KEY_TAB, last_tab)
    if triggered
        character_index = (character_index + 1) % character_count
        player_skel = character_skeles[character_index]
        player_texture = character_textures[character_index]
        println format("Character: %s", character_names[character_index])
    endif

    # ---- Free camera toggle (C key) ----
    triggered, last_c_key = toggle_pressed(window, GLFW_KEY_C, last_c_key)
    if triggered
        free_camera = !free_camera
        if free_camera
            # Save the current chase-camera state so we can restore it exactly.
            saved_camera_offset_x = camera_offset_x
            saved_camera_offset_y = camera_offset_y
            saved_camera_offset_z = camera_offset_z
            # Start free cam from the actual camera position, not the ideal offset.
            free_cam_pos[0] = player_pos[0] + camera_offset_x
            free_cam_pos[1] = player_pos[1] + camera_offset_y
            free_cam_pos[2] = player_pos[2] + camera_offset_z
            free_cam_yaw = player_yaw
            free_cam_pitch = player_pitch
            println "Free camera: ON"
        else
            # Snap the chase camera instantly back to the saved offset.
            camera_offset_x = saved_camera_offset_x
            camera_offset_y = saved_camera_offset_y
            camera_offset_z = saved_camera_offset_z
            last_player_yaw = player_yaw
            camera_return_timer = 0.0
            println "Free camera: OFF — restored chase view"
        endif
    endif

    # ---- Home key: reset camera to default chase view ----
    triggered, last_home_key = toggle_pressed(window, GLFW_KEY_HOME, last_home_key)
    if triggered
        free_camera = false
        free_cam_pitch = -0.3
        println "Camera reset to chase view"
    endif

    player_pitch=player_pitch[-1.553343:1.553343]

    player_yaw = player_yaw % 6.28318530718
    on player_yaw < 0 do player_yaw = player_yaw + 6.28318530718

    # ---- Update skeletal animation state ----
    if !c_ptr_is_null(player_skel)
        player_anim_time = player_anim_time + delta_time * anim_playback_speed
        if player_is_moving
            if is_sprinting
                player_anim_name = "CharacterArmature|Run"
            else
                player_anim_name = "CharacterArmature|Walk"
            endif
        else
            player_anim_name = "CharacterArmature|Idle"
        endif
        # Loop animation based on its actual duration
        anim_dur = skel_get_anim_duration(player_skel, player_anim_name)
        if anim_dur > 0.0
            player_anim_time = player_anim_time % anim_dur
        endif
        skel_animate(player_skel, player_anim_name, player_anim_time)
    endif

    glDisable(GL_SCISSOR_TEST)
    glViewport(0, 0, actual_window_width, actual_window_height)
    glClearColor(current_sky_color[0], current_sky_color[1], current_sky_color[2], 1.0)
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT)

    glDisable(GL_BLEND)
    glEnable(GL_CULL_FACE)

    glMatrixMode(GL_PROJECTION)
    glLoadIdentity()
    if actual_window_height > 0
        aspect_ratio = actual_window_width / actual_window_height
    else
        aspect_ratio = 1.0
    endif
    frustum_half_width = 0.1
    if aspect_ratio > 0
        frustum_half_height = frustum_half_width / aspect_ratio
    else
        frustum_half_height = 0.075
    endif
    glFrustum(-frustum_half_width, frustum_half_width, -frustum_half_height, frustum_half_height, 0.1, VIEW_DISTANCE)

    glMatrixMode(GL_MODELVIEW)
    glLoadIdentity()

    if free_camera
        # Free camera mode: use free cam position and orientation
        yaw_degrees = free_cam_yaw * 57.2957795
        pitch_degrees = free_cam_pitch * 57.2957795
        camera_x = free_cam_pos[0]
        camera_y = free_cam_pos[1]
        camera_z = free_cam_pos[2]
    else
        # Chase camera: over-the-shoulder with offset smoothing.
        yaw_degrees = player_yaw * 57.2957795
        pitch_degrees = player_pitch * 57.2957795

        desired_offset_x = sin(player_yaw) * CAMERA_DISTANCE + cos(player_yaw) * CAMERA_SIDE
        desired_offset_y = CAMERA_HEIGHT
        desired_offset_z = cos(player_yaw) * CAMERA_DISTANCE - sin(player_yaw) * CAMERA_SIDE

        delta_yaw = player_yaw - last_player_yaw
            on delta_yaw > 3.14159265359 do delta_yaw = delta_yaw - 6.28318530718
            on delta_yaw < -3.14159265359 do delta_yaw = delta_yaw + 6.28318530718

            # Rotate the current camera offset by the yaw delta so the camera stays
            # at the same relative angle when the player turns.
            if delta_yaw != 0.0
                dx = camera_offset_x
                dz = camera_offset_z
                new_dx = dx * cos(delta_yaw) + dz * sin(delta_yaw)
                new_dz = -dx * sin(delta_yaw) + dz * cos(delta_yaw)
                camera_offset_x = new_dx
                camera_offset_z = new_dz
            endif

            # Smooth any drift in the offset (mostly useful for collision avoidance
            # and snapping back after free-cam mode).
            t = CAMERA_SMOOTH_SPEED * delta_time
            if t > 1.0
                t = 1.0
            endif
            camera_offset_x = camera_offset_x + (desired_offset_x - camera_offset_x) * t
            camera_offset_y = camera_offset_y + (desired_offset_y - camera_offset_y) * t
            camera_offset_z = camera_offset_z + (desired_offset_z - camera_offset_z) * t

            # Camera collision avoidance: cast from player to desired camera position
            # and clamp the offset length so the camera doesn't clip through walls.
            # Hysteresis: only pull the camera in when the obstruction is at least
            # 0.05 units closer than the desired offset, preventing micro-bouncing.
            if camera_collision_enabled
                desired_cam_x = player_pos[0] + camera_offset_x
                desired_cam_z = player_pos[2] + camera_offset_z
                safe_dist = camera_raycast_distance(player_pos[0], player_pos[2], desired_cam_x, desired_cam_z)
                offset_len = sqrt(camera_offset_x * camera_offset_x + camera_offset_z * camera_offset_z)
                if safe_dist < offset_len - 0.05
                    safe_dist = safe_dist - CAMERA_COLLISION_MARGIN
                    if safe_dist < 0.0
                        safe_dist = 0.0
                    endif
                    if offset_len > safe_dist
                        scale = safe_dist / offset_len
                        camera_offset_x = camera_offset_x * scale
                        camera_offset_z = camera_offset_z * scale
                    endif
                endif
            endif

        camera_x = player_pos[0] + camera_offset_x
        camera_y = player_pos[1] + camera_offset_y
        camera_z = player_pos[2] + camera_offset_z

        last_player_yaw = player_yaw
    endif

    glRotatef(-pitch_degrees, 1, 0, 0)
    glRotatef(-yaw_degrees, 0, 1, 0)
    glTranslatef(-camera_x, -camera_y, -camera_z)

    # Draw the sky dome before anything else so it sits behind the world.
    draw_sky(camera_x, camera_y, camera_z)

    # Set sun direction in world space (w=0 => directional light)
    dir = current_sun_dir
    light_pos = c_alloc_floats32(4)
    c_array_set_float32(light_pos, 0, dir[0])
    c_array_set_float32(light_pos, 1, dir[1])
    c_array_set_float32(light_pos, 2, dir[2])
    c_array_set_float32(light_pos, 3, 0.0)
    glLightfv(GL_LIGHT0, GL_POSITION, light_pos)
    c_free(light_pos)

    # Bonfire point light (GL_LIGHT1) — warm orange, attenuated, only when lit.
    bonfire_lit = false
    for i = 0 to interactables.len - 1 step 5
        if interactables[i + 3] == 2
            bonfire_lit = interactable_states[i / 5] != 0
        endif
    endfor
    if bonfire_lit
        glEnable(GL_LIGHT1)
        bf_pos = c_alloc(16)
        c_set_float(bf_pos, 0, bonfire_x)
        c_set_float(bf_pos, 4, 0.3)
        c_set_float(bf_pos, 8, bonfire_z)
        c_set_float(bf_pos, 12, 1.0)
        glLightfv(GL_LIGHT1, GL_POSITION, bf_pos)
        c_free(bf_pos)
        bf_amb = c_alloc(16)
        c_set_float(bf_amb, 0, 0.1)
        c_set_float(bf_amb, 4, 0.05)
        c_set_float(bf_amb, 8, 0.0)
        c_set_float(bf_amb, 12, 1.0)
        glLightfv(GL_LIGHT1, GL_AMBIENT, bf_amb)
        c_free(bf_amb)
        bf_diff = c_alloc(16)
        c_set_float(bf_diff, 0, 0.6)
        c_set_float(bf_diff, 4, 0.3)
        c_set_float(bf_diff, 8, 0.1)
        c_set_float(bf_diff, 12, 1.0)
        glLightfv(GL_LIGHT1, GL_DIFFUSE, bf_diff)
        c_free(bf_diff)
        bf_spec = c_alloc(16)
        c_set_float(bf_spec, 0, 0.3)
        c_set_float(bf_spec, 4, 0.15)
        c_set_float(bf_spec, 8, 0.05)
        c_set_float(bf_spec, 12, 1.0)
        glLightfv(GL_LIGHT1, GL_SPECULAR, bf_spec)
        c_free(bf_spec)
        glLightf(GL_LIGHT1, GL_CONSTANT_ATTENUATION, 1.0)
        glLightf(GL_LIGHT1, GL_LINEAR_ATTENUATION, 0.5)
        glLightf(GL_LIGHT1, GL_QUADRATIC_ATTENUATION, 0.1)
    else
        glDisable(GL_LIGHT1)
    endif

    draw_scene()
    draw_particles()
    draw_bonfire_particles()
    draw_interactable_glow(glfwGetTime())

    glDisable(GL_FOG)
    glDisable(GL_DEPTH_TEST)

    # Wireframe mode must not affect 2D overlay quads (HUD + legend)
    on wireframe_mode do glPolygonMode(GL_FRONT_AND_BACK, GL_FILL)

    glMatrixMode(GL_PROJECTION)
    glPushMatrix()
    glLoadIdentity()
    glOrtho(0.0, actual_window_width, 0.0, actual_window_height, -1.0, 1.0)

    glMatrixMode(GL_MODELVIEW)
    glPushMatrix()
    glLoadIdentity()

    # 2D overlay panels
    glEnable(GL_BLEND)
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA)

    # Get mouse position for hover/drag detection (scale to framebuffer coords)
    mouse_x_ptr = c_alloc(8)
    mouse_y_ptr = c_alloc(8)
    glfwGetCursorPos(window, mouse_x_ptr, mouse_y_ptr)
    mouse_x = c_get_double(mouse_x_ptr, 0) * mouse_scale_x
    mouse_y = actual_window_height - c_get_double(mouse_y_ptr, 0) * mouse_scale_y
    c_free(mouse_x_ptr)
    c_free(mouse_y_ptr)

    # Update clock panel text with current time + FPS + total static tri count + feet height
    fps_str = format("%.0f", actual_fps)
    tri_str = format("%d", total_scene_tris)
    surface_h = get_surface_height(player_pos[0], player_pos[2])
    feet_y = player_pos[1] - player_feet_offset
    if surface_h == ROAD_TOP_HEIGHT
        surface_name = "road"
    else if surface_h > ROAD_TOP_HEIGHT + 0.01
        surface_name = "door"
    else
        surface_name = floor_solid ? "floor" : "grass"
    endif
    cull_str = format("%d/%d", last_culled_count, last_total_count)
    clock_text = format_world_clock() + " " + time_of_day_names[time_of_day] + " | FPS: " + fps_str + "\nTris: " + tri_str + " | Culled: " + cull_str + "\nFeetY: " + format("%.2f", feet_y) + " | Surface: " + format("%.2f", surface_h) + "[" + surface_name + "]"
    on clock_panel[PANEL_TEXT] != clock_text do update_panel_text(clock_panel, clock_text)
    # Keep the clock panel fully on-screen even after its size changes
    clock_panel[PANEL_X] = clock_panel[PANEL_X][0.0:actual_window_width - clock_panel[PANEL_W]]
    clock_panel[PANEL_Y] = clock_panel[PANEL_Y][0.0:actual_window_height - clock_panel[PANEL_H]]
    draw_panel(clock_panel, mouse_x, mouse_y)

    # Interactive prompt panel (shows when near an interactable)
    if prompt_panel[PANEL_VISIBLE]
        draw_panel(prompt_panel, mouse_x, mouse_y)
    endif

    # Message panel (temporary interaction feedback)
    if message_panel[PANEL_VISIBLE]
        draw_panel(message_panel, mouse_x, mouse_y)
    endif

    # Legend panel: keep width in sync with screen, but preserve user-dragged X/Y
    legend_panel[PANEL_W] = actual_window_width * 0.9
    on legend_panel[PANEL_NEEDS_UPDATE] do update_panel_text(legend_panel, build_legend_text())
    # Clamp to screen in case the window resized
    legend_panel[PANEL_X] = legend_panel[PANEL_X][0.0:actual_window_width - legend_panel[PANEL_W]]
    legend_panel[PANEL_Y] = legend_panel[PANEL_Y][0.0:actual_window_height - legend_panel[PANEL_H]]
    draw_panel(legend_panel, mouse_x, mouse_y)

    # Minimap panel (draggable + resizable radar)
    if minimap_panel[PANEL_VISIBLE]
        draw_panel(minimap_panel, mouse_x, mouse_y)
        draw_minimap(minimap_panel)
        draw_panel_resize_handles(minimap_panel)
    endif

    glDisable(GL_BLEND)

    glMatrixMode(GL_MODELVIEW)
    glPopMatrix()
    glMatrixMode(GL_PROJECTION)
    glPopMatrix()

    # Restore wireframe mode for 3D scene if it was active
    on wireframe_mode do glPolygonMode(GL_FRONT_AND_BACK, GL_LINE)

    glEnable(GL_DEPTH_TEST)

    # swap
    swap_before = glfwGetTime()
    glfwSwapBuffers(window)
    swap_after = glfwGetTime()
    swap_time = swap_after - swap_before
    # Swap timing disabled to avoid CLI noise on llvmpipe

    frame_end_time = glfwGetTime()
    frame_elapsed = frame_end_time - frame_loop_start

    on frame_elapsed > 0 do uncapped_fps = 1.0 / frame_elapsed

    frame_count++
    current_time = glfwGetTime()
    if current_time - last_fps_print_time >= 1.0
        fps_sample_end_time = current_time
        sample_duration = fps_sample_end_time - fps_sample_start_time
        if sample_duration > 0.0
            actual_fps = frame_count / sample_duration
            cam_y_deg = player_yaw * 57.2957795
            cam_p_deg = player_pitch * 57.2957795
        endif
        fps_sample_start_time = fps_sample_end_time
        last_fps_print_time = current_time
        frame_count = 0
    endif

endwhile

# ---- On-exit doorstep calibration report ----
if surveyed_positions.len > 0
    println ""
    println "=== Surveyed position report ==="
    for si = 0 to surveyed_positions.len - 1 step 2
        sx = surveyed_positions[si].as_float
        sz = surveyed_positions[si + 1].as_float
        midx, vname = nearest_building_variant(sx, sz)
        step_raw = 0.0
        if midx >= 0 && midx < building_variant_count
            step_raw = building_variant_step_raw[midx]
        endif
        println format("  pos=(%.2f,%.2f) nearest=%s [variant %d] step_raw=%.2f", sx, sz, vname, midx, step_raw)
    endfor
    println ""
    println "Final building_variant_step_raw array:"
    line = ""
    for vi = 0 to building_variant_count - 1
        vname = building_variant_files[vi][0]
        line = line + format("%s=%.2f ", vname, building_variant_step_raw[vi])
    endfor
    println line
    println "================================"
    println ""
endif

println "Clean getaway"
# Save minimap position+size on exit
save_panel_position(minimap_panel, minimap_pos_file)
unlock_os_thread()
c_unregister_callback(framebuffer_callback)
c_unregister_callback(scroll_callback)
glfwDestroyWindow(window)
glfwTerminate()


